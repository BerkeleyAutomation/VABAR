(define (problem TOOLHANGING-MEDIUM-HANGWRENCH-002)
 (:domain tool_hanging) (:language hang both wrenches on the two hooks)
 (:staging (:scene tool_hanging_bench) (:embodiment yam_tool_hanging (:work-arm left) (:support-arm right)) (:physics tool_hanging_480hz@v1) (:cameras tool_hanging_views_level1@v2) (:control-mode joint_position) (:episodes (:count 1) (:seed 5) (:sampler fixed)) (:max-steps 22000))
