(define (problem TOOLHANGING-MEDIUM-HANGWRENCH-001)
 (:domain tool_hanging) (:language hang both wrenches on the two hooks)
 (:staging (:scene tool_hanging_bench) (:embodiment yam_tool_hanging (:work-arm left) (:support-arm right)) (:physics tool_hanging_480hz@v1) (:cameras tool_hanging_views_level1@v2) (:control-mode joint_position) (:episodes (:count 1) (:seed 1) (:sampler fixed)) (:max-steps 22000))
 (:objects wrench_1 - wrench_adjustable_260 wrench_2 - wrench_adjustable_260 distractor_scissors_1 - scissor_pair_1 distractor_pliers_2 - plier_combination distractor_screwdriver_3 - screwdriver_slim)
 (:fixtures wrench_hook_1 - pegboard_hook wrench_hook_2 - pegboard_hook) (:init)
