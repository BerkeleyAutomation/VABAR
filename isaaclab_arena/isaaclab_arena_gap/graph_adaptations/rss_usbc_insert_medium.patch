+def _fit_socket(ctx, rgb, depth, K, T, shape, mouth_hint, axis_hint, query):
+    """Select the bulkhead by measured surface support, not SAM score alone.
+
+    Silver also describes the plug tip. A braced bulkhead can rotate away from
+    its overhead heading, so recover with its current visible principal axis.
+    The RSS registration still checks inliers, residual, rank and movement.
+    """
+    result = ctx.tool("sam3.segment_text", image=rgb, query=query, max_results=0)
+    fits = []
+    prior = np.asarray(axis_hint, dtype=float)
+    for mask, score in zip(result.get("masks") or [], result.get("scores") or [], strict=True):
+        if float(score) < RECEPTACLE_SCORE:
+            continue
+        points = _to_world(_foreground_mask(mask, depth), depth, K, T)
+        points = points[np.linalg.norm(points - np.asarray(mouth_hint), axis=1) < 0.080]
+        if len(points) < 150:
+            continue
+        fit = fit_receptacle(points, shape, mouth_hint, axis_hint)
+        if fit is None:
+            fresh_axis = np.r_[_principal_xy(points), 0.0]
+            if fresh_axis @ prior < 0.0:
+                fresh_axis = -fresh_axis
+            fit = fit_receptacle(points, shape, mouth_hint, fresh_axis)
+        if fit is not None:
+            fits.append(fit)
+    return min(fits, key=lambda fit: fit["residual_m"]) if fits else None


 def _principal_xy(points: np.ndarray) -> np.ndarray:
