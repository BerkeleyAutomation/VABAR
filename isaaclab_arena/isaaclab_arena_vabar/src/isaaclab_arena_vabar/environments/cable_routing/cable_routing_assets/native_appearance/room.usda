    def Scope "Materials"
    {
        def Material "finish_1"
        {
            token outputs:surface.connect = </root/Materials/finish_1/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/Materials/finish_1/DiffuseTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.88
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }

            def Shader "PrimvarSt"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "UvTransform"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </root/Materials/finish_1/PrimvarSt.outputs:result>
                float2 inputs:scale = (0.8333333, 0.8333333)
                float2 inputs:translation = (0, 0)
                float2 outputs:result
            }

            def Shader "DiffuseTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./room_concrete_v2.png@
                token inputs:sourceColorSpace = "auto"
                float2 inputs:st.connect = </root/Materials/finish_1/UvTransform.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
                float3 outputs:rgb
            }
        }

        def Material "finish_2"
        {
            token outputs:surface.connect = </root/Materials/finish_2/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </root/Materials/finish_2/DiffuseTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.94
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }

            def Shader "PrimvarSt"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "UvTransform"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </root/Materials/finish_2/PrimvarSt.outputs:result>
                float2 inputs:scale = (0.8, 0.8)
                float2 inputs:translation = (0, 0)
                float2 outputs:result
            }

            def Shader "DiffuseTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./room_plaster_v2.png@
                token inputs:sourceColorSpace = "auto"
                float2 inputs:st.connect = </root/Materials/finish_2/UvTransform.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
                float3 outputs:rgb
            }
        }

        def Material "finish_3"
        {
            token outputs:surface.connect = </root/Materials/finish_3/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.28, 0.29)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
    }

    def Xform "_LabDome"
    {
        uniform token[] xformOpOrder = []

        def DomeLight "light"
        {
            color3f inputs:color = (0.94, 0.95, 0.97)
            float inputs:intensity = 1350
        }
    }

    def Xform "_LabPanel"
    {
        double3 xformOp:translate = (0.6, 0, 2.45)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def RectLight "light"
        {
            color3f inputs:color = (1, 0.97, 0.92)
            float inputs:height = 0.9
            float inputs:intensity = 5000
            float inputs:width = 1.4
        }
    }
}
