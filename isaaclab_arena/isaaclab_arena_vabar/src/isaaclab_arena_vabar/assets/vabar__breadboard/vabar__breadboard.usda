#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__breadboard_01.usd@</RootNode>
) {
    # AUTOLab's 2F-85 level-1 suite stages breadboard_1.obj: this 8 mm board with its
    # thickness stretched 2.5x to 20 mm (level1_11/12/21/28, scene_meta tool_collision: box).
    # The graph closes with the TCP 20 mm above the bin floor, and the 2F-85 fingertips reach
    # the floor only near full closure, so they pass over an 8 mm board and land on its top.
    # Mass stays AUTOLab's; the inertia below is the 20 mm board's.
    double3 xformOp:scale = (1, 1, 2.5)
    uniform token[] xformOpOrder = ["xformOp:scale"]

    over "Geometry" {
        over "industrial_breadboard_0_g0_visual_obj_00" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        ) {
            # Inertia of the voxelised visual mesh at uniform density and the delivered mass.
            # Taken about the delivered centre of mass, 3.3 mm from this model's. The delivered
            # inertia was 2.3/6.1/3.4x this on its principal axes (above the physical limit for
            # this shape). Mass unchanged.
            # Stretched with the root scale: the second moment along z grows 2.5^2, so this is
            # the 8 mm board's (8.494e-06, 2.062e-05, 2.831e-05) at 20 mm. Newton scales the
            # centre of mass by the root scale but not the inertia, so the inertia here is the
            # runtime value and the centre of mass stays in the unscaled frame.
            point3f physics:centerOfMass = (0.0008512307, 0.0025416638, 0.0024843223)
            float3 physics:diagonalInertia = (1.0614438e-05, 2.2736479e-05, 2.833177e-05)
            float physics:mass = 0.03474001
            quatf physics:principalAxes = (0.02703205, -0.70580057, 0.70783302, -0.0093404751)

            over "industrial_breadboard_0_g0_visual_mesh_00" (
                delete apiSchemas = ["PhysicsMassAPI"]
            ) {
                bool physics:collisionEnabled = 0
            }

            # AUTOLab's level-1 scenes collide this board as its mesh's bounding box (one box geom,
            # condim 4; the drawn mesh has contype=0). The stretched mesh, collided as itself, took
            # 7.9 s to settle in the drop check and still turned 0.0085 rad in its final second.
            def Cube "BoundingBoxCollider" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            ) {
                rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__rough_white_a01>
                uniform token purpose = "guide"
                double size = 2
                float3 xformOp:scale = (0.027396, 0.04205, 0.004)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }

    over "PhysicsMaterials" {
        over "physics_mat_m_opaque__plastic__rough_white_a01" {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }
}
