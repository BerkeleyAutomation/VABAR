#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "industrial_multimeter_0_g0_visual" (
        prepend references = @./geometries.usd@</Geometries/industrial_multimeter_0_g0_visual>
    )
    {
        over "industrial_multimeter_0_g0_visual" (
            apiSchemas = ["MaterialBindingAPI", "MjcImageableAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/industrial_multimeter_0_g0_visual/VisualMaterials/industrial_multimeter_0_multimeter_mat>
            int mjc:group = 1
        }

        def Scope "VisualMaterials"
        {
            def Material "industrial_multimeter_0_multimeter_mat" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/industrial_multimeter_0_multimeter_mat>
            )
            {
            }
        }
    }
}
