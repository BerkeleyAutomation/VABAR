#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "base"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "base"
{
    over "Geometry"
    {
        over "vabar__multimeter"
        {
            over "industrial_multimeter_0_g0" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:condim = 4
            }

            over "industrial_multimeter_0_default_site" (
                prepend apiSchemas = ["MjcSiteAPI"]
            )
            {
            }

            over "industrial_multimeter_0_g0_visual"
            {
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["MjcMaterialAPI"]
        )
        {
            uniform double mjc:rollingfriction = 0.02
            uniform double mjc:torsionalfriction = 0.05
        }
    }

    over "Materials"
    {
    }

    over "VisualMaterials"
    {
    }
}
