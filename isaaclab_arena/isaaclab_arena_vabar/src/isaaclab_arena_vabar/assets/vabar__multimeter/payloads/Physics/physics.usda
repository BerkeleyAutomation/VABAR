#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "base"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "base" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
)
{
    bool newton:selfCollisionEnabled = 0

    over "Geometry"
    {
        over "vabar__multimeter" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            over "industrial_multimeter_0_g0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "PhysicsMassAPI"]
            )
            {
                float newton:contactGap = 0
                float physics:density = 1000
                float physics:mass = 0.398371
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.02
            float newton:torsionalFriction = 0.05
            float physics:dynamicFriction = 1
        }
    }
}
