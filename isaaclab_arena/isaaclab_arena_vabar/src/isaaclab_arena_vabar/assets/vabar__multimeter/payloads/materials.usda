#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "industrial_multimeter_0_multimeter_mat"
    {
        asset inputs:DiffuseTexture = @../Textures/diffuse_4.png@
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.9
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/industrial_multimeter_0_multimeter_mat/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/industrial_multimeter_0_multimeter_mat/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/industrial_multimeter_0_multimeter_mat/DiffuseTexture.outputs:rgb>
            prepend float inputs:metallic.connect = </Materials/industrial_multimeter_0_multimeter_mat.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/industrial_multimeter_0_multimeter_mat.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/industrial_multimeter_0_multimeter_mat.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }

        def Shader "DiffuseTexture" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:fallback = (1, 1, 1, 1)
            prepend asset inputs:file.connect = </Materials/industrial_multimeter_0_multimeter_mat.inputs:DiffuseTexture>
            token inputs:sourceColorSpace = "auto"
            prepend float2 inputs:st.connect = </Materials/industrial_multimeter_0_multimeter_mat/Primvar_st_float2.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
}
