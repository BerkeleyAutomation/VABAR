#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__cutting_pliers_01.usd@</RootNode>
) {
    over "Geometry" {
        over "base_01_obj_00" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        ) {
            # Two-material inertia of the voxelised visual mesh at the delivered mass: its metal
            # parts 5.8x as dense as the handle, the split closest to the delivered centre of
            # mass. Taken about the delivered centre of mass, 0.2 mm from this model's. The
            # delivered inertia was 1.6/2.9/2.8x this on its principal axes (81% of the physical
            # limit for this shape). Mass unchanged.
            point3f physics:centerOfMass = (5.7159519e-05, 0.010796987, -0.0006578344)
            float3 physics:diagonalInertia = (4.6730946e-05, 0.00037169872, 0.00040277625)
            float physics:mass = 0.20000001
            quatf physics:principalAxes = (0.0072732643, 0.70613978, 0.70800718, -0.0062891821)

            over "base_01_mesh_00" (
                delete apiSchemas = ["PhysicsMassAPI"]
            ) {
                bool physics:collisionEnabled = 0
            }

            def Xform "StoredConvexCollision" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                prepend references = @collision_hulls.usdc@</Asset>
            ) {
                rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chromeScratched_a01>

                over "Hull_000" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chromeScratched_a01>
                }

                over "Hull_001" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chromeScratched_a01>
                }

                over "Hull_002" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chromeScratched_a01>
                }

                over "Hull_003" (
