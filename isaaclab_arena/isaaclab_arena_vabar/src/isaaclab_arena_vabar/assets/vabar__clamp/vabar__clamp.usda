    over "Geometry" {
        over "clamp_obj_00" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        ) {
            # Inertia of the voxelised visual mesh at uniform density and the delivered mass. The
            # centre of mass is the model's: the delivered one sat 6 mm from any metal/handle
            # density split of this mesh. The delivered inertia was 0.9/2.0/1.7x this on its
            # principal axes. Mass unchanged.
            point3f physics:centerOfMass = (0.011462389, -0.010542785, -0.0021573918)
            float3 physics:diagonalInertia = (0.00021579181, 0.00041643321, 0.00058959397)
            float physics:mass = 0.25139335
            quatf physics:principalAxes = (0.052504183, -0.65198696, -0.75635817, 0.0088678007)

            over "clamp_mesh_00" (
                delete apiSchemas = ["PhysicsMassAPI"]
            ) {
                bool physics:collisionEnabled = 0
            }

