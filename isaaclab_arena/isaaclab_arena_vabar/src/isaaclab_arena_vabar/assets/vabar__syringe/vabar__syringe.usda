#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

# The albedo (simready_usd/textures/t_syringe_a01_alb.png) is SimReady's own: the same
# white barrel, grey plunger and red cap as AUTOLab v1.0's syringe (diffuse_2.png), which
# its RTX perception camera shows white on the tray. A teal tint scored 0.007-0.07 on
# SAM3's "syringe" query in the both-syringe scene, under the graph's 0.08 count gate.
def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__syringe_01.usd@</RootNode>
) {
    over "Geometry" {
        over "syringe_01_obj_00" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        ) {
            point3f physics:centerOfMass = (-1.7238747e-7, -0.012434371, 3.5859337e-8)
            float3 physics:diagonalInertia = (0.000030499892, 5.135534e-7, 0.000030529893)
            float physics:mass = 0.02491309
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "syringe_01_mesh_00" (
                delete apiSchemas = ["PhysicsMassAPI"]
            ) {
                bool physics:collisionEnabled = 0
            }

            def Xform "StoredConvexCollision" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                prepend references = @collision_hulls.usdc@</Asset>
            ) {
                rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01> (
                    bindMaterialAs = "strongerThanDescendants"
                )

                over "Hull_000" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }

                over "Hull_001" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }

                over "Hull_002" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }

                over "Hull_003" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }

                over "Hull_004" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }

                over "Hull_005" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }

                over "Hull_006" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }

                over "Hull_007" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }

                over "Hull_008" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                }
            }

            def Cube "CollisionProxy" (
                active = false
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            ) {
                double size = 1
                token purpose = "guide"
                rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__plastic__syringe_a01>
                double3 xformOp:scale = (0.0295660002, 0.1560000060, 0.0196019997)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }

    over "PhysicsMaterials" {
        over "physics_mat_m_opaque__plastic__syringe_a01" {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }
}
