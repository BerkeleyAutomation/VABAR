        ) {
            # Inertia of the voxelised visual mesh at uniform density and the delivered mass. The
            # centre of mass is the model's: the delivered one sat 10 mm from the mesh's
            # uniform-density centre. The delivered inertia was 3.0/1.3/1.4x this on its principal
            # axes. Mass unchanged.
            point3f physics:centerOfMass = (-0.0022594116, -8.9942636e-05, 1.2286503e-05)
            float3 physics:diagonalInertia = (8.3479306e-06, 0.00015419467, 0.00015427925)
            float physics:mass = 0.12217801
            quatf physics:principalAxes = (0.62764244, -0.77850159, 0.00043001524, -0.0002479537)

            over "industrial_tactical_flashlight_0_g0_visual_mesh_00" (
                delete apiSchemas = ["PhysicsMassAPI"]
            ) {
                bool physics:collisionEnabled = 0
            }

