#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1
    bool physics:rigidBodyEnabled = 1
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Scope "Looks"
    {
        def Material "Orange"
        {
            token outputs:surface.connect = </Asset/Looks/Orange/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.35, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Metal"
        {
            token outputs:surface.connect = </Asset/Looks/Metal/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.38, 0.40, 0.43)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "BrightMetal"
        {
            token outputs:surface.connect = </Asset/Looks/BrightMetal/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.77)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def Scope "PhysicsMaterials"
    {
        def Material "Fixture" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 2
            float physics:restitution = 0
            float physics:staticFriction = 2
        }
    }

    def Cube "RailLeft" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        bool physics:collisionEnabled = 1
        rel material:binding = </Asset/Looks/Metal>
        rel material:binding:physics = </Asset/PhysicsMaterials/Fixture>
        color3f[] primvars:displayColor = [(0.38, 0.40, 0.43)]
        uniform token primvars:displayColor:interpolation = "constant"
        double size = 1
        double3 xformOp:translate = (0, -0.0105, 0.0025)
        double3 xformOp:scale = (0.032, 0.011, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "RailRight" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        bool physics:collisionEnabled = 1
        rel material:binding = </Asset/Looks/Metal>
        rel material:binding:physics = </Asset/PhysicsMaterials/Fixture>
        color3f[] primvars:displayColor = [(0.38, 0.40, 0.43)]
        uniform token primvars:displayColor:interpolation = "constant"
        double size = 1
        double3 xformOp:translate = (0, 0.0105, 0.0025)
        double3 xformOp:scale = (0.032, 0.011, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Hood" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        bool physics:collisionEnabled = 1
        rel material:binding = </Asset/Looks/Orange>
        rel material:binding:physics = </Asset/PhysicsMaterials/Fixture>
        color3f[] primvars:displayColor = [(0.85, 0.35, 0.12)]
        uniform token primvars:displayColor:interpolation = "constant"
        double size = 1
        double3 xformOp:translate = (-0.008, 0, 0.01025)
        double3 xformOp:scale = (0.016, 0.032, 0.0045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Saddle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        bool physics:collisionEnabled = 1
        rel material:binding = </Asset/Looks/Orange>
        rel material:binding:physics = </Asset/PhysicsMaterials/Fixture>
        color3f[] primvars:displayColor = [(0.85, 0.35, 0.12)]
        uniform token primvars:displayColor:interpolation = "constant"
        double size = 1
        double3 xformOp:translate = (0.008, 0, 0.01025)
        double3 xformOp:scale = (0.0064, 0.032, 0.0045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cylinder "ScrewLeft" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.0018
        rel material:binding = </Asset/Looks/BrightMetal>
        color3f[] primvars:displayColor = [(0.72, 0.74, 0.77)]
        uniform token primvars:displayColor:interpolation = "constant"
        double radius = 0.0025
        double3 xformOp:translate = (-0.008, -0.0105, 0.0059)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "ScrewRight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.0018
        rel material:binding = </Asset/Looks/BrightMetal>
        color3f[] primvars:displayColor = [(0.72, 0.74, 0.77)]
        uniform token primvars:displayColor:interpolation = "constant"
        double radius = 0.0025
        double3 xformOp:translate = (-0.008, 0.0105, 0.0059)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
