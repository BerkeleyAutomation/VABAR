#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__flathead_screwdriver_01.usd@</RootNode>
) {
    over "Geometry" {
        over "flathead_screwdriver_0_g0_visual_obj_00" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        ) {
            # Two-material inertia of the voxelised visual mesh at the delivered mass: its metal
            # parts 6.5x as dense as the handle, the split closest to the delivered centre of
            # mass. Taken about the delivered centre of mass, 4.7 mm from this model's. The
            # delivered inertia was 1.3/1.5/1.5x this on its principal axes. Mass unchanged.
            point3f physics:centerOfMass = (0.024253959, 5.2816158e-05, 3.3687212e-07)
            float3 physics:diagonalInertia = (6.4546593e-06, 0.00031341438, 0.00031376311)
            float physics:mass = 0.12854628
            quatf physics:principalAxes = (0.92272567, 0.3854526, -0.00046401265, 0.001846432)

            over "flathead_screwdriver_0_g0_visual_mesh_00" (
                delete apiSchemas = ["PhysicsMassAPI"]
            ) {}
        }
    }

    over "PhysicsMaterials" {
        over "physics_mat_m_opaque__rubber__flathead_screwdrivera_01" {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }
}
