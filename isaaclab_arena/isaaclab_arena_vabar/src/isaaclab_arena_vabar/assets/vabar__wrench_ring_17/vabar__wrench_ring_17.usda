                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_03" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_04" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_05" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_06" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_07" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_08" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_09" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_10" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_11" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_12" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "ConvexHull_13" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__chrome_a01>
                }

                over "Visual" (
                    active = false
                ) {}
            }
        }
    }

    over "PhysicsMaterials" {
        over "physics_mat_m_opaque__metal__chrome_a01" {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1
        }
    }
