#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "tn__pandahand_k9"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tn__pandahand_k9" (
    displayName = "panda hand"
)
{
    def Scope "Materials"
    {
        def Material "off_white" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/off_white>
        )
        {
        }

        def Material "black" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/black>
        )
        {
        }

        def Material "white" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/white>
        )
        {
        }
    }

    over "Geometry"
    {
        over "hand"
        {
            over "hand_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </tn__pandahand_k9/Materials/off_white>
            }

            over "hand_1" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </tn__pandahand_k9/Materials/black>
            }

            over "hand_2" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </tn__pandahand_k9/Materials/black>
            }

            over "hand_3" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </tn__pandahand_k9/Materials/white>
            }

            over "hand_4" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </tn__pandahand_k9/Materials/off_white>
            }

            over "left_finger"
            {
                over "finger_0" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </tn__pandahand_k9/Materials/off_white>
                }

                over "finger_1" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </tn__pandahand_k9/Materials/black>
                }
            }

            over "right_finger"
            {
                over "finger_0" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </tn__pandahand_k9/Materials/off_white>
                }

                over "finger_1" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </tn__pandahand_k9/Materials/black>
                }
            }
        }
    }
}
