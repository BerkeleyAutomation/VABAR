            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI", "MjcMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
        }

        def MjcTendon "split"
        {
            uniform token mjc:actuatorfrclimited = "false"
            prepend rel mjc:path = [
                </tn__pandahand_k9/Geometry/hand/left_finger/finger_joint1>,
                </tn__pandahand_k9/Geometry/hand/right_finger/finger_joint2>,
            ]
            uniform double[] mjc:path:coef = [0.5, 0.5]
            uniform int[] mjc:path:indices = [0, 1]
            uniform token mjc:type = "fixed"
        }

        def MjcActuator "actuator8"
        {
            uniform double[] mjc:biasPrm = [0, -100, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 255
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            uniform double[] mjc:gainPrm = [0.01568627451, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </tn__pandahand_k9/Physics/split>
        }
    }

