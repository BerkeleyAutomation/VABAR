#usda 1.0
(
    """One hand-authored correction to the converted franka_fr3 base: the base
    link's inertial.

    MuJoCo Menagerie's `fr3.xml` authors NO `<inertial>` on `fr3_link0` --
    unlike every other body in the model, and unlike the sibling `franka_fr3_v2`,
    which gives its base 3.85 kg. MuJoCo therefore derives link0's mass from its
    geoms, and Menagerie's `collision` default class
    (`<geom type=\"mesh\" group=\"3\" mass=\"0\" density=\"0\"/>`) keeps the
    convex collision hull out of the sum, leaving the seven visual pieces to
    produce 2.820672 kg.

    That `mass=\"0\"` reaches USD intact -- `Payload/Physics.usda` authors
    `float physics:mass = 0` on `fr3_link0_collision` -- but the USD->MJCF
    round trip used to build this asset counts the hull at MuJoCo's default
    density, which adds 2.9965 kg (the volume of `link0.stl` at 1000 kg/m^3),
    and the mass normalization pass bakes that into an authored inertial of
    5.817 kg. No other body in either FR3 is affected: every other body carries
    its own Menagerie `<inertial>`, which wins over any geom-derived value.

    The values below are MuJoCo's own derivation from Menagerie's model, read
    off `fr3.xml` directly. They are not a Franka measurement -- Menagerie does
    not author one -- but they are exactly what a consumer of Menagerie's model
    gets, which is the property this package is meant to preserve.

    The `over` hierarchy is rooted at `franka_fr3_v1`, not Menagerie's model
    name `fr3`, because the conversion renames the root; body prim names are
    untouched, which is why they are still `fr3_link0`.
    """
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "franka_fr3_v1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "franka_fr3_v1" (
    prepend apiSchemas = ["GeomModelAPI", "MjcSceneAPI"]
    assetInfo = {
        string name = "franka_fr3_v1"
    }
    kind = "component"
    prepend payload = @franka_fr3_v1/Payload/Contents.usda@
    variants = {
        string gripper = "franka_hand"
    }
    prepend variantSets = "gripper"
)
{
    float3[] extentsHint = [(-0.154073, -0.1294, 0), (0.169281, 0.129921, 1.114922), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (-0.15407869, -0.12937313, -0.000032492775), (0.16930613, 0.12990427, 1.1146809)]
    uniform token mjc:option:integrator = "implicitfast"

    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["PhysxArticulationAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (1e-7, 1e-7, 1e-7)
            float physics:mass = 0.0001
            quatf physics:principalAxes = (1, 0, 0, 0)
            custom bool physxArticulation:enabledSelfCollisions = 0
            custom int physxArticulation:solverPositionIterationCount = 32
            custom int physxArticulation:solverVelocityIterationCount = 1
            custom float physxRigidBody:angularDamping = 0.05
            custom float physxRigidBody:linearDamping = 0
            custom int physxRigidBody:solverPositionIterationCount = 16
            custom int physxRigidBody:solverVelocityIterationCount = 1

            over "fr3_link0" (
                prepend apiSchemas = ["PhysxRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.02985482, -0.000248355, 0.057579286)
                float3 physics:diagonalInertia = (0.011467894, 0.011257366, 0.007685107)
                float physics:mass = 2.820672
