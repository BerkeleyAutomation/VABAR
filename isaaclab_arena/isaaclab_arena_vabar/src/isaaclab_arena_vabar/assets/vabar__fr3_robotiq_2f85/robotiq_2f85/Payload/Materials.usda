#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "robotiq_2f85"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "robotiq_2f85"
{
    def Scope "Materials"
    {
        def Material "black" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/black>
        )
        {
        }

        def Material "metal" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/metal>
        )
        {
        }
    }

    over "Geometry"
    {
        over "robotiq_base"
        {
            over "base" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </robotiq_2f85/Materials/black>
            }

            over "base_coupling" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </robotiq_2f85/Materials/black>
            }

            over "tn__ca0185open_VF58" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </robotiq_2f85/Materials/metal>
            }

            over "robotiq_left_driver"
            {
                over "driver" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </robotiq_2f85/Materials/metal>
                }

                over "robotiq_left_coupler"
                {
                    over "coupler" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/black>
                    }
                }
            }

            over "robotiq_left_spring_link"
            {
                over "spring_link" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </robotiq_2f85/Materials/black>
                }

                over "robotiq_left_follower"
                {
                    over "follower" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/black>
                    }

                    over "tongue" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/metal>
                    }
                }
            }

            over "robotiq_right_driver"
            {
                over "driver" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </robotiq_2f85/Materials/metal>
                }

                over "robotiq_right_coupler"
                {
                    over "coupler" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/black>
                    }
                }
            }

            over "robotiq_right_spring_link"
            {
                over "spring_link" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </robotiq_2f85/Materials/black>
                }

                over "robotiq_right_follower"
                {
                    over "tongue" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/metal>
                    }

                    over "follower" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/black>
                    }
                }
            }
        }
    }
}
