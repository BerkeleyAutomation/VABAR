                                        float drive:angular:physics:stiffness = 0.000017453292
                                        custom double newton:limitDamping = 1.7453292519943295
                                        custom double newton:limitStiffness = 43.63323129985824
                                        custom float physxJoint:armature = 0.0018
                                    }
                                }

                                over "joint5" (
                                    prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
                                )
                                {
                                    float drive:angular:physics:stiffness = 0.000017453292
                                    custom double newton:limitDamping = 1.7453292519943295
                                    custom double newton:limitStiffness = 43.63323129985824
                                    custom float physxJoint:armature = 0.0018
                                }
                            }

                            over "joint4" (
                                prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
                            )
                            {
                                float drive:angular:physics:stiffness = 0.000017453292
                                custom double newton:limitDamping = 1.7453292519943295
                                custom double newton:limitStiffness = 43.63323129985824
                                custom float physxJoint:armature = 0.0018
                            }
                        }

                        over "joint3" (
                            prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
                        )
                        {
                            float drive:angular:physics:stiffness = 0.000017453292
                            custom double newton:limitDamping = 1.7453292519943295
                            custom double newton:limitStiffness = 43.63323129985824
                            custom float physxJoint:armature = 0.032
                        }
                    }

                    over "joint2" (
                        prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
                    )
                    {
                        float drive:angular:physics:stiffness = 0.000017453292
                        custom double newton:limitDamping = 1.7453292519943295
                        custom double newton:limitStiffness = 43.63323129985824
                        custom float physxJoint:armature = 0.032
                    }
                }

                over "joint1" (
                    prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
                )
                {
                    float drive:angular:physics:stiffness = 0.000017453292
                    custom double newton:limitDamping = 1.7453292519943295
                    custom double newton:limitStiffness = 43.63323129985824
                    custom float physxJoint:armature = 0.032
                }
            }
        }
    }

    variantSet "gripper" = {
        # AUTOLab's tool-hanging YAM.
        "crank_4310" (
            variants = {
                string kinematics = "menagerie"
            }
        ) {

        }
        # The crank hand with AUTOLab's tool-hanging finger travel: its yam_tool_hanging
        # MJCF is this MuJoCo Menagerie hand with each finger opening to 47.5 mm, not 37.5 mm.
        "crank_4310_wide" (
            variants = {
                string kinematics = "menagerie"
            }
        ) {
            over "Geometry"
            {
                over "arm"
                {
                    over "link_1"
                    {
                        over "link_2"
                        {
                            over "link_3"
                            {
                                over "link_4"
                                {
                                    over "link_5"
                                    {
                                        over "link_6"
                                        {
                                            over "link_left_finger"
                                            {
                                                over "left_finger"
                                                {
                                                    float physics:upperLimit = 0.0475
                                                }
                                            }
                                            over "link_right_finger"
                                            {
                                                over "right_finger"
                                                {
                                                    float physics:lowerLimit = -0.0475
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        # AUTOLab plans this hand's cells (cable routing, USB-C) on its yam_i2rt chain.
        "linear_4310" (
            variants = {
                string kinematics = "autolab_v1"
            }
        ) {
            over "Geometry"
            {
                over "arm"
                {
                    over "link_1"
                    {
                        over "link_2"
                        {
                            over "link_3"
                            {
                                over "link_4"
                                {
                                    over "link_5"
                                    {
                                        over "link_6" (
                                            prepend apiSchemas = ["PhysicsMassAPI"]
                                        )
                                        {
                                            point3f physics:centerOfMass = (0, 0, 0)
                                            float3 physics:diagonalInertia = (1e-7, 1e-7, 1e-7)
                                            float physics:mass = 0.0001
                                            quatf physics:principalAxes = (1, 0, 0, 0)

                                            over "model2__12" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "model2__13" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "Capsule" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "Capsule_1" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "Capsule_2" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "model2__12__render_instance" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "model2__13__render_instance" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "tcp_site" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "grasp_site" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "link_left_finger" (
                                                active = false
                                            )
                                            {
                                            }

                                            over "link_right_finger" (
                                                active = false
                                            )
                                            {
                                            }

                                            def Xform "linear_4310_attach" (
                                                prepend references = [@linear_4310/fingertip_colliders.usda@</linear_4310>, @linear_4310/linear_4310.usda@</linear_4310>]
                                                variants = {
                                                    string Physics = "physics"
                                                }
                                            )
                                            {
                                                quatf xformOp:orient = (0, 0, 0, 1)
                                                double3 xformOp:translate = (0, 0, 0)
                                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                                                over "Geometry"
                                                {
                                                    over "gripper" (
                                                        delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
                                                    )
                                                    {
                                                        custom float mjc:body:gravcomp = 1
                                                        custom float mjc:gravcomp = 1

                                                        over "PhysicsFixedJoint" (
                                                            active = false
                                                        )
                                                        {
                                                        }

                                                        over "tip_left"
                                                        {
                                                            custom float mjc:body:gravcomp = 1
                                                            custom float mjc:gravcomp = 1

                                                            over "joint7"
                                                            {
                                                                float drive:linear:physics:damping = 10
                                                                float drive:linear:physics:stiffness = 100
                                                                uniform double mjc:armature = 0.05
                                                                uniform double mjc:damping = 2
                                                                uniform double mjc:frictionloss = 0.5
                                                                float newton:armature = 0.05
                                                                float newton:damping = 2
                                                                float newton:friction = 0.5
                                                                float physxJoint:armature = 0.05
                                                                float physxJoint:jointFriction = 0.5
                                                            }

                                                            over "tip_left" (
                                                                instanceable = false
                                                            )
                                                            {
                                                                over "tip_left"
                                                                {
                                                                    color3f[] primvars:displayColor = [(0.25, 0.25, 0.25)]
                                                                }
                                                            }
                                                        }

                                                        over "tip_right"
                                                        {
                                                            custom float mjc:body:gravcomp = 1
                                                            custom float mjc:gravcomp = 1

                                                            over "joint8"
                                                            {
                                                                uniform double mjc:armature = 0.05
                                                                uniform double mjc:damping = 2
                                                                uniform double mjc:frictionloss = 0.5
                                                                float newton:armature = 0.05
                                                                float newton:damping = 2
                                                                float newton:friction = 0.5
                                                                float physxJoint:armature = 0.05
                                                                float physxJoint:jointFriction = 0.5
                                                            }

                                                            over "tip_right" (
                                                                instanceable = false
                                                            )
                                                            {
                                                                over "tip_right"
                                                                {
                                                                    color3f[] primvars:displayColor = [(0.25, 0.25, 0.25)]
                                                                }
                                                            }
                                                        }

                                                        over "gripper" (
                                                            instanceable = false
                                                        )
                                                        {
                                                            over "gripper"
                                                            {
                                                                color3f[] primvars:displayColor = [(0.25, 0.25, 0.25)]
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            def PhysicsFixedJoint "linear_4310_gripper_attach_joint"
                                            {
                                                rel physics:body0 = </i2rt_yam/Geometry/arm/link_1/link_2/link_3/link_4/link_5/link_6>
                                                rel physics:body1 = </i2rt_yam/Geometry/arm/link_1/link_2/link_3/link_4/link_5/link_6/linear_4310_attach/Geometry/gripper>
                                                point3f physics:localPos0 = (0, 0, 0)
                                                point3f physics:localPos1 = (0, -0, 0)
                                                quatf physics:localRot0 = (0, 0, 0, 1)
                                                quatf physics:localRot1 = (-6.123235e-17, 0.7071068, 0.7071068, 2.2993474e-17)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

        }
    }

    # Which of AUTOLab's two YAM chains the arm has. `menagerie` (also no
    # selection) is this asset as MuJoCo Menagerie ships it: AUTOLab's tool-hanging
    # yam_tool_hanging and its cuRobo URDF, base frame 10 mm above the base's
    # underside. `autolab_v1` is the generated base_frame + autolab_v1 layers:
    # AUTOLab's yam_i2rt (cable routing, USB-C), frame on the underside. The
    # linear_4310 hand selects it; the crank hands select `menagerie`.
    variantSet "kinematics" = {
        "menagerie" {
            over "Geometry"
            {
                over "arm"
                {
                    point3f physics:centerOfMass = (0, 0, 0.026)
                }
            }
        }
        "autolab_v1" (
            prepend references = [@kinematics/autolab_v1.usda@</i2rt_yam>, @kinematics/base_frame.usda@</i2rt_yam>]
        ) {
            over "Geometry"
            {
                over "arm"
                {
                    point3f physics:centerOfMass = (0, 0, 0.036)
                }
            }
        }
    }
}
