#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "linear_4310"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "linear_4310"
{
    over "Geometry"
    {
        over "gripper"
        {
            over "tip_left"
            {
                over "joint7" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }

            over "tip_right"
            {
                over "joint8" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }
        }
    }
}
