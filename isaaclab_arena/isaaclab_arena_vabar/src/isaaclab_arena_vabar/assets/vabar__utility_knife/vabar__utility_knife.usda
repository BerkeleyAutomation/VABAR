#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__utility_knife_01.usd@</RootNode>
) {
    over "Geometry" {
        over "utility_knife_01_obj_00" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        ) {
            # Two-material inertia of the voxelised visual mesh at the delivered mass: its metal
            # parts 2.3x as dense as the handle, the split closest to the delivered centre of
            # mass. The centre of mass is the model's: the delivered one sat 6 mm from any
            # metal/handle density split of this mesh. The delivered inertia was 1.8/1.9/1.9x this
            # on its principal axes. Mass unchanged.
            point3f physics:centerOfMass = (0.0058689734, -0.018330384, -0.00087742606)
            float3 physics:diagonalInertia = (5.7479244e-06, 0.00013220407, 0.00013746864)
            float physics:mass = 0.04224205
            quatf physics:principalAxes = (0.0006418628, 0.72705707, 0.68657469, -0.0016733988)

            over "utility_knife_01_mesh_00" (
                delete apiSchemas = ["PhysicsMassAPI"]
            ) {
                bool physics:collisionEnabled = 0
            }

            def Xform "StoredConvexCollision" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                prepend references = @collision_hulls.usdc@</Asset>
            ) {
                rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01> (
                    bindMaterialAs = "strongerThanDescendants"
                )

                over "Hull_000" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_001" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_002" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_003" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_004" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_005" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_006" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_007" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_008" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_009" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_010" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_011" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_012" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }

                over "Hull_013" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                ) {
                    rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                }
            }

            def Cube "CollisionProxy" (
                active = false
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            ) {
                double size = 1
                token purpose = "guide"
                rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
                double3 xformOp:scale = (0.0552440015, 0.2117020068, 0.0160739999)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }

    over "PhysicsMaterials" {
        over "physics_mat_m_opaque__metal__aluminiumBrushed_d01" {
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }

    def Cube "DropCollisionProxy" (
        active = false
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    ) {
        double size = 1
        token purpose = "guide"
        rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__aluminiumBrushed_d01>
        double3 xformOp:scale = (0.0552440015, 0.2117020068, 0.0160739999)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
}
