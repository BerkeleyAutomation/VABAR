#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__hanging_hammer_2_01.usd@</RootNode>
) {
    over "Geometry" {
        over "Visual_obj_00" {
            over "Visual_mesh_00" {
                # Two-material inertia of the voxelised visual mesh at the delivered mass: its metal
                # parts 6.1x as dense as the handle, the split closest to the delivered centre of
                # mass. The centre of mass is the model's: the delivered one sat 13 mm from any
                # metal/handle density split of this mesh. The delivered inertia was 1.3/1.0/1.0x this
                # on its principal axes. Mass unchanged.
                point3f physics:centerOfMass = (-0.092303084, -0.015566529, 0.047591639)
                float3 physics:diagonalInertia = (0.00035471981, 0.0064138372, 0.0067322734)
                float physics:mass = 0.63978243
                quatf physics:principalAxes = (0.70698251, 0.70688435, 0.015654749, -0.015658184)
            }
        }
    }

    over "PhysicsMaterials" {
        over "physics_mat_m_opaque__metal__steelStainless_clean_a01" {
            float physics:dynamicFriction = 2
            float physics:staticFriction = 2
        }
    }
}
