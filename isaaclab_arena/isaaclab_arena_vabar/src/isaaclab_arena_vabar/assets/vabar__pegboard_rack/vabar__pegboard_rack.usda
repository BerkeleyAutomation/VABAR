#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "MaterialBindingAPI"]
)
{
    rel material:binding = </Asset/pegboard_material> (
        bindMaterialAs = "strongerThanDescendants"
    )
    bool physics:kinematicEnabled = 1
    bool physics:rigidBodyEnabled = 1
    float3[] extentsHint = [(-0.02, -0.32, -0.24), (0.02, 0.32, 0.24)]

    def Xform "panel_lower_left" (
        prepend references = @payloads/meshes.usdc@</Asset/pegboard_0_0>
    )
    {
        quatd xformOp:orient = (0.7071067690849304, 0, 0.7071067932881644, 0)
        double3 xformOp:translate = (0, -0.16, -0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "panel_lower_right" (
        prepend references = @payloads/meshes.usdc@</Asset/pegboard_0_1>
    )
    {
        quatd xformOp:orient = (0.7071067690849304, 0, 0.7071067932881644, 0)
        double3 xformOp:translate = (0, 0.16, -0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "panel_upper_left" (
        prepend references = @payloads/meshes.usdc@</Asset/pegboard_1_0>
    )
    {
        quatd xformOp:orient = (0.7071067690849304, 0, 0.7071067932881644, 0)
        double3 xformOp:translate = (0, -0.16, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "panel_upper_right" (
        prepend references = @payloads/meshes.usdc@</Asset/pegboard_1_1>
    )
    {
        quatd xformOp:orient = (0.7071067690849304, 0, 0.7071067932881644, 0)
        double3 xformOp:translate = (0, 0.16, 0.12)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Material "pegboard_material"
    {
        token outputs:surface.connect = </Asset/pegboard_material/shader.outputs:surface>

        def Shader "shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6, 0.372549, 0.184314)
            float inputs:metallic = 0
            float inputs:roughness = 0.85
            token outputs:surface
        }
    }
}
