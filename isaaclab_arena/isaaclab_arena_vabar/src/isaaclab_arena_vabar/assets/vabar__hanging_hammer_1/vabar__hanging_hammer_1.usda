#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__hanging_hammer_1_01.usd@</RootNode>
) {
    over "Geometry" {
        over "hammer_01_obj_00" {
            over "hammer_01_mesh_00" {
                # Two-material inertia of the voxelised visual mesh at the delivered mass: its metal
                # parts 6.1x as dense as the handle, the split closest to the delivered centre of
                # mass. The centre of mass is the model's: the delivered one sat 13 mm from any
                # metal/handle density split of this mesh. The delivered inertia was 1.3/1.0/1.0x this
                # on its principal axes. Mass unchanged.
                point3f physics:centerOfMass = (-0.092098961, -0.015564992, 0.047595499)
                float3 physics:diagonalInertia = (0.00035501777, 0.0063995919, 0.0067183507)
                float physics:mass = 0.63978356
                quatf physics:principalAxes = (0.70689694, -0.70697032, 0.015646542, 0.015648156)
            }
        }
    }
}
