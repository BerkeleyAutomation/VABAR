#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__wire_spool_01.usd@</RootNode>
)
{
    over "Geometry"
    {
        over "industrial_wire_spool_0_g0_visual_obj_00"
        {
            over "industrial_wire_spool_0_g0_visual_mesh_00"
            {
                # Inertia of the voxelised visual mesh at uniform density and the delivered mass.
                # Taken about the delivered centre of mass, 0.9 mm from this model's. The delivered
                # inertia was 4.0/4.1/3.8x this on its principal axes (above the physical limit for
                # this shape). Mass unchanged.
                point3f physics:centerOfMass = (-0.00031608625, 0.00019939643, 0.00084288715)
                float3 physics:diagonalInertia = (4.7306256e-07, 4.7456292e-07, 5.8521153e-07)
                float physics:mass = 0.00670301
                quatf physics:principalAxes = (0.0081045801, -0.53043882, -0.84768315, -0.0015021205)
            }
        }
    }
}
