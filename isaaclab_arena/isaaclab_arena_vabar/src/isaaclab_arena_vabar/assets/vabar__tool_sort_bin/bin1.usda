#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    prepend references = @simready_bin1/sm_bin1_01.usd@</RootNode>
)
{
    bool physics:kinematicEnabled = 1
    bool physics:rigidBodyEnabled = 1
    float3[] extentsHint = [(-0.21, -0.26, -0.02), (0.21, 0.26, 0.10)]

    def Xform "placement_surface"
    {
        def Points "bounds"
        {
            float3[] extent = [(-0.18, -0.23, 0.01), (0.18, 0.23, 0.02)]
            point3f[] points = [(-0.18, -0.23, 0.01), (0.18, 0.23, 0.02)]
            float[] primvars:displayOpacity = [0] (
                interpolation = "constant"
            )
            float[] widths = [0, 0]
        }
    }
}
