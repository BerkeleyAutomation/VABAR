#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend references = @simready_usd/sm_vabar__bulkhead_01.usd@</RootNode>
) {
    over "Geometry" {
        over "bulkhead_01_obj_00" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        ) {
            float physics:mass = 0.09
            over "bulkhead_01_mesh_00" (
                delete apiSchemas = ["PhysicsMassAPI"]
            ) {
                bool physics:collisionEnabled = false
                double xformOp:rotateX = 90
                uniform token[] xformOpOrder = ["xformOp:rotateX"]
            }
            def Mesh "SourceCollisionMesh" (
                prepend references = @source_collision_mesh.usdc@</Geometry>
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonSDFCollisionAPI", "MaterialBindingAPI"]
            ) {
                bool physics:collisionEnabled = true
                uniform token physics:approximation = "none"
                uniform token purpose = "guide"
                bool newton:hydroelasticEnabled = true
                float newton:sdfTargetVoxelSize = 0.00025
                float newton:sdfNarrowBandInner = -0.005
                float newton:sdfNarrowBandOuter = 0.005
                float newton:sdfPadding = 0.006
                float newton:hydroelasticStiffness = 1e10
                int mjc:condim = 3
                rel material:binding:physics = </Asset/PhysicsMaterials/physics_mat_m_opaque__metal__glossy_a01>
            }
        }
    }
    over "PhysicsMaterials" {
        over "physics_mat_m_opaque__metal__glossy_a01" {
            float physics:staticFriction = 2.5
            float physics:dynamicFriction = 2.5
            float physics:restitution = 0
        }
    }
}
