          "$ref": "fixture.aperture_center"
        },
        "rim_z": {
          "$ref": "fixture.rim_z"
        }
      }
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "robot.open_gripper",
          "inputs": {}
        },
        {
          "tool": "robot.go_home",
          "inputs": {}
        }
      ]
    }
  },
  "edges": [
    [
      "START",
      "target"
    ]
  ],
  "conditional_edges": {
    "target": {
      "router_field": "exit",
      "mapping": {
        "found": "fixture",
        "not_found": "abort"
      }
    },
    "fixture": {
      "router_field": "exit",
      "mapping": {
        "found": "collision_world",
        "not_found": "abort"
      }
    },
    "collision_world": {
      "router_field": "exit",
      "mapping": {
        "built": "grasp",
        "failed": "abort"
      }
    },
    "grasp": {
      "router_field": "exit",
      "mapping": {
        "grasped": "hand_map",
        "failed": "abort"
      }
    },
    "hand_map": {
      "router_field": "exit",
      "mapping": {
        "mapped": "mate",
        "not_found": "abort"
      }
    },
    "mate": {
      "router_field": "exit",
      "mapping": {
        "computed": "carry_plan",
        "infeasible": "abort"
      }
    },
    "carry_plan": {
      "router_field": "exit",
      "mapping": {
        "planned": "carry",
        "blocked": "abort"
      }
    },
    "carry": {
      "router_field": "exit",
      "mapping": {
        "reoriented": "insert_plan",
        "blocked": "abort"
      }
    },
    "insert_plan": {
      "router_field": "exit",
      "mapping": {
        "planned": "insert",
        "blocked": "abort"
      }
    },
    "insert": {
      "router_field": "exit",
      "mapping": {
        "placed": "verify",
        "blocked": "abort"
      }
    },
    "verify": {
      "router_field": "exit",
      "mapping": {
        "verified": "remaining",
        "failed": "abort"
      }
    },
    "remaining": {
      "router_field": "exit",
      "mapping": {
        "more": "target",
        "none": "done"
      }
    }
  },
