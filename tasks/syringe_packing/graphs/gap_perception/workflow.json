          "$ref": "fixture.fixture_axis"
        },
        "rim_z": {
          "$ref": "fixture.rim_z"
        },
        "world_config": {
          "$ref": "collision_world.world_config"
        },
        "attached_object": {
          "$ref": "hand_map.attached_object"
        }
      }
    },
    "insert": {
