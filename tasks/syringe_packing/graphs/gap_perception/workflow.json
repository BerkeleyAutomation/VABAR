{
  "version": 3,
  "meta": {
    "name": "sharps_disposal_gap_perception",
    "description": "Tool-hanging-shaped RGB-D pipeline: separately perceive syringe and aperture features, grasp, map the held tip into TCP, collision-aware reorient, mate directed tip with opening, release, and visually verify.",
    "composes": {
      "target_sg": "perceiving-functional-features",
      "fixture_sg": "perceiving-functional-features",
      "collision_world_sg": "perceiving-objects",
      "grasp_sg": "grasping-direct-ik",
      "hand_map_sg": "registering-held-objects",
      "carry_plan_sg": "planning-held-object-motion",
      "carry_sg": "executing-held-object-motion",
      "insert_plan_sg": "planning-held-object-motion",
      "remaining_sg": "perceiving-objects",
      "verify_sg": "perceiving-objects"
    },
    "composes_note": "Subgraphs listed in `composes` run this graph's own scripts for the named skill, so they are labelled `generic`: graph-as-policy's SK1/SK2 contract reserves a bundle label for subgraphs that run that bundle's canonical scripts."
  },
  "nodes": {
    "target": {
      "type": "subgraph",
      "ref": "target_sg"
    },
    "fixture": {
      "type": "subgraph",
      "ref": "fixture_sg"
    },
    "collision_world": {
      "type": "subgraph",
      "ref": "collision_world_sg",
      "inputs": {
        "target_mask": {
          "$ref": "target.target_mask"
        },
