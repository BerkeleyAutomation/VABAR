        },
        "rim_z": {
          "$ref": "fixture.rim_z"
        }
      }
    },
    "grasp": {
      "type": "subgraph",
      "ref": "grasp_sg",
      "inputs": {
        "target_obb": {
          "$ref": "target.target_obb"
        },
        "target_cloud": {
          "$ref": "target.target_cloud"
        },
        "needle_cap_center": {
          "$ref": "target.cap_center"
        }
      }
    },
    "hand_map": {
      "type": "subgraph",
      "ref": "hand_map_sg",
      "inputs": {
        "insertion_pose": {
          "$ref": "target.insertion_pose"
        },
