; -*- mode: lisp -*-
; TRIAL 01 of 30 in the tray_clutter layout sweep: 8 syringes
; packed into the tray (see tasks/syringe_packing/tools/make_sweeps.py for the placement
; rule), the sharps box shifted by (-0.0291, +0.0260) m. Drawn from numpy
; default_rng(seed=5), one draw per trial in sequence -- box shift
; uniform(+-0.03) m.
; Written by tasks/syringe_packing/tools/make_sweeps.py from tray_clutter.template.task; the
; layout is poses/tray_clutter_t01.json. Everything else is the base document's.
; AUTHORED, over the `syringe` export, as `tray_pair`
; with its scene made hard the other way `tray_pair`'s header warned against:
; VAB-industrial's own ten-syringe rack "defeated the perception graph", so
; that document kept one spare and 90 mm of clear air. Level 2 asks the
; question the level-0/1 documents deliberately ducked -- can the graph
; still find, grasp and post EVERY syringe once the tray is genuinely
; cluttered, 3-8 near-identical barrels laid down at uneven spacing and a
; few degrees of skew rather than one clean neighbour. The goal is every
; syringe object this trial declares In the box (the same all-of-them
; predicate `tray_pair_both` uses for two, extended
; here to however many a layout holds), exercising the graph's own
; count_remaining loop over more iterations and a shrinking, still-cluttered
; scene rather than the one second syringe that task validated. The fixtures
; and regions are unchanged from `tray_pair`; only
; the tray's population, the goal's width and each trial's layout are this
; document's own.
;
; WHERE THINGS ARE. Same rule as `tray_pair`: BDDL has no coordinates, and
; each trial's `poses/tray_clutter_tNN.json` is the layout its (:start-poses
; ...) names, written by the 30-trial sweep (tasks/syringe_packing/tools/make_sweeps.py)
; as a fresh 5-8 syringe packing rather than a rigid transform of one
; template -- see that tool's own header for the placement rule and why.
;
; THE TRAY DOES NOT COLLIDE AS DRAWN. Same fixture, same stand-in floor slab
; and walls; see `tray_pair`'s header and records.py.
; ---------------------------------------------------------------------------

(define (problem DISPOSE_THE_SYRINGE_FROM_THE_CLUTTERED_TRAY_T01)
  (:domain robosuite)

  (:language pick up every syringe from the cluttered instrument tray, one at a
             time, and drop it through the hole in the top of the yellow sharps
             disposal box, until the tray is empty)

  (:staging
    (:profile sharps_vab_industrial@v1)
    ; The export's own free body is dropped: it carries the syringe's authored
    ; box collider, and every syringe here arrives from `records.syringe` --
    ; the same mesh, colliding on its CoACD hulls.
    (:export vab_tool_sort/syringe (:strip-free-bodies true))
    ; Where every free body and the tray stand: recorded, with each
    ; handle's own fields (each syringe's mass and grip, a spare's colour).
    ; What a syringe is *made of* -- the drawn mesh, its map, and the CoACD
    ; hulls it collides on -- is records.py's, stated once.
    (:start-poses poses/tray_clutter_t01.json)
    ; Level 2: every syringe in the tray is now a goal (the loader-loop
    ; the graph shares with tray_pair_both routes back through target_sg
    ; after each post until count_remaining finds none left), so the
    ; budget scales with how many are in this layout: 8 x tray_pair's
    ; own 11400 (2400 for one goal plus a flat 9000 container retry) = 91200.
    (:max-steps 91200)
    ; A wave builds tray_clutter_base's model for this document; the
    ; serial runner ignores this and builds its own, which stays the reference.
    (:fleet-base syringe_packing/tray_clutter_base)
  )

  (:fixtures
    bin1 - robosuite_bin
    bin2 - robosuite_bin
    syringe_box - sharps_box
  )

  (:objects
    syringe_0 syringe_pack_0 syringe_pack_1 syringe_pack_2 syringe_pack_3 syringe_pack_4 syringe_pack_5 syringe_pack_6 - syringe
  )

  (:regions
    (bin1_region
        (:target bin1)
        (:ranges ((-0.18 -0.23 0.18 0.23)))
    )
    (bin2_syringe_region
        (:target bin2)
        (:ranges ((0.0 -0.245 0.195 0.0)))
    )
    (syringe_box_region
        (:target syringe_box)
        (:ranges ((-0.073628 -0.057007 0.015372 0.108993)))
        ; The box this trial moved by (-0.029128, +0.025993) m in bin2; the aperture's
        ; frame is the export's, so the ranges carry the move.
    )
  )

  (:init)

  ; One goal, over the goal syringe only -- every other instance in the tray
  ; is a distractor the graph must not grab instead, not a second target.
  (:goal
    (and
      (In syringe_0 syringe_box_region)
      (In syringe_pack_0 syringe_box_region)
      (In syringe_pack_1 syringe_box_region)
      (In syringe_pack_2 syringe_box_region)
      (In syringe_pack_3 syringe_box_region)
      (In syringe_pack_4 syringe_box_region)
      (In syringe_pack_5 syringe_box_region)
      (In syringe_pack_6 syringe_box_region)
    )
  )

  (:artifacts
    (:routine "routine:RoutineSharpsDisposal")
    (:tools   "tools:register_syringe_packing_tools")
    (:graph gt "graphs/gt")
    (:graph gap_perception "graphs/gap_perception")
  )

  (:hosts
    ; The same arena with the Panda cut out of it, hosting a YAM: the export
    ; welds its robot into the room, so a foreign one needs the stripped file.
    (:host (:embodiment yam_i2rt (:work-arm right) (:support-arm left))
           (:static-override workcell scene_norobot_boxm0p0290p026.xml)
           (:notes "compiles; no policy"))
    ; The stripped arena hosting the six-jointed arm, its hand welded on.
    (:host (:embodiment ur5 (:work-arm right))
           (:static-override workcell scene_norobot_boxm0p0290p026.xml)
           (:notes "compiles; no policy"))
    ; The same robot wearing the i2rt gripper -- the fourth axis, taking a value.
    (:host (:embodiment ur5 (:work-arm right)) (:gripper linear_4310_attached)
           (:static-override workcell scene_norobot_boxm0p0290p026.xml)
           (:notes "compiles; no policy"))
    ; The export's own Panda wearing a Robotiq 2F-85: `panda_robotiq`, a
    ; registered embodiment over the hand-free standalone asset.
    (:host (:embodiment panda_robotiq (:work-arm right))
           (:static-override workcell scene_norobot_boxm0p0290p026.xml)
           (:graphs gap_perception)
           (:notes "the reference pairing: gap_perception runs here"))
  )
  (:provenance
    (:tier original)
    (:source "Authored for this corpus over the AUTOLab-GaP-NVIDIA-Collaboration/
              VAB-industrial ToolSortPickPlace `syringe` export (robosuite 1.4.0,
              MuJoCo 3.3.3, seed 0). The goal and regions restate
              tray_pair's; the clutter restates the
              scale of VAB-industrial's own put_ten_syringes_in_the_sharps_box
              without its all-ten goal.")
    (:note "Level 2 of the packing work: tray_pair was
            level 0 (one spare), tray_pair_both level 1
            (both asked for). This document keeps level 0's single-syringe
            goal and instead widens the scene -- 5-8 syringes per trial,
            vabar/scripts/make_tray_clutter_trials.py.")
  )
)
