; -*- mode: lisp -*-
; -------------------------------------------------------------------------
; AUTHORED HERE -- an instrument, not a new task.
;
; provenance.tier: reproduction
; source-of-record: assets/vab_tool_sort/sort_electrical/
;
; This is sort_electrical_kit_into_bins.bddl again -- same export, same ten
; objects, same settled poses, same regions, same goals, same budget -- with one
; line changed: `(:objects-from usd)`. The workcell's own free bodies are
; stripped on import and each object arrives instead from
; industrial/<asset>/<asset>.usdc, a stage carrying PhysicsRigidBodyAPI, the
; export's mass on PhysicsMassAPI, `physics:approximation = boundingCube` and a
; physics material holding its friction. Newton's add_usd reads all of that, so
; on this variant THE STAGE DECIDES THE PHYSICS and the document states none.
;
; WHY IT EXISTS. Against sort_electrical this asks whether Newton's USD import
; reproduces the MJCF scene at all. Against its pair -- the geometry-only
; variant beside it -- it isolates *which half* of the import a difference came
; from: the physics description, or the triangles. One question needs both, and
; both need everything else held fixed, which is why nothing above the staging
; line differs from the MJCF original. A number measured here is attributable to
; the importer because nothing else moved.
;
; The stages are written by tools/build_industrial_usd.py, which transcribes
; mass and friction off the export's *colliding* geom rather than off the
; per-asset MJCF: the two disagree on friction (1.0 against 2.0), and only the
; box actually collides. Taking the asset's number would have doubled the
; friction in both USD flavours and made the comparison measure the mistake
; instead of the importer.
;
; Requires the [usd] extra. A checkout without pxr cannot build this variant.
; -------------------------------------------------------------------------

(define (problem SORT_ELECTRICAL_THROUGH_USD)

  (:language sort the eight electrical kit items out of bin1 into the
             compartment of bin2 whose label names each one)

  (:staging
    (:profile vab_tool_sort@v2)
    ; The MJCF variant's export, named again rather than derived -- this is the
    ; same scene, and dumping a second copy of a 55 MB arena to say so would be
    ; the mistake `hammer` sharing `sort_all`'s export already avoids.
    ; The workcell wearing the materials its MJCF states -- see assets/look.py.
    (:export vab_tool_sort/sort_electrical
      (:entity tool_sort_workcell))
    ; The one line that makes this variant what it is. `usd` resolves each
    ; object's type to its asset record's declared `usd` file; see
    ; tasks/tool_sort/assets/records.py::USD_STAGES.
    (:objects-from usd)
    ; The comparison triple's collider, overriding the suite's `drawn_hull`:
    ; see sort_electrical.task. On this flavour the stage carries its own
    ; `physics:approximation`, so the clause reaches only the recorded poses
    ; and states the same thing the stage does.
    (:collider bounding_box)
    (:max-steps 19200)
  )

  (:fixtures
    bin1 - bin
    bin2 - bin
  )

  (:objects
    industrial_d_battery_0 - battery
    industrial_d_battery_1 - battery
    industrial_multimeter_0 - multimeter
    industrial_multimeter_1 - multimeter
    industrial_tactical_flashlight_0 - flashlight
    industrial_tactical_flashlight_1 - flashlight
    industrial_safety_glasses_0 - safety_glasses
    industrial_safety_glasses_1 - safety_glasses
    distractor_industrial_cutting_pliers_0 - cutting_pliers
    distractor_industrial_screwdriver_0 - screwdriver
  )

  ; Identical to the MJCF variant's, deliberately: the regions are the bin's
  ; geometry and this variant changes only where the objects come from.
  (:regions
    (bin1_region
        (:target bin1)
        (:ranges ((-0.18 -0.23 0.18 0.23)))
    )
    (bin2_battery_region
        (:target bin2)
        (:ranges ((-0.195 -0.245 0.0 0.0)))
    )
    (bin2_multimeter_region
        (:target bin2)
        (:ranges ((0.0 -0.245 0.195 0.0)))
    )
    (bin2_flashlight_region
        (:target bin2)
        (:ranges ((-0.195 0.0 0.0 0.245)))
    )
    (bin2_safety_glasses_region
        (:target bin2)
        (:ranges ((0.0 0.0 0.195 0.245)))
    )
  )

  (:init
    (In industrial_d_battery_0 bin1_region)
    (In industrial_d_battery_1 bin1_region)
    (In industrial_multimeter_0 bin1_region)
    (In industrial_multimeter_1 bin1_region)
    (In industrial_tactical_flashlight_0 bin1_region)
    (In industrial_tactical_flashlight_1 bin1_region)
    (In industrial_safety_glasses_0 bin1_region)
    (In industrial_safety_glasses_1 bin1_region)
    (In distractor_industrial_cutting_pliers_0 bin1_region)
    (In distractor_industrial_screwdriver_0 bin1_region)
  )

  (:goal
    (And
      (In industrial_d_battery_0 bin2_battery_region)
      (In industrial_d_battery_1 bin2_battery_region)
      (In industrial_multimeter_0 bin2_multimeter_region)
      (In industrial_multimeter_1 bin2_multimeter_region)
      (In industrial_tactical_flashlight_0 bin2_flashlight_region)
      (In industrial_tactical_flashlight_1 bin2_flashlight_region)
      (In industrial_safety_glasses_0 bin2_safety_glasses_region)
      (In industrial_safety_glasses_1 bin2_safety_glasses_region)
    )
  )

  (:artifacts
    (:routine "routine:RoutineToolSort")
    (:tools   "tools:register_tool_sort_tools")
    (:graph gt "graphs/gt")
    (:graph gap_perception "graphs/gap_perception")
  )

  (:provenance
    (:tier reproduction)
    (:source "VAB-industrial ToolSortPickPlace,
              robosuite 1.4.0, MuJoCo 3.3.3, seed 2, restated through USD")
    (:upstream-file "sort_electrical_kit_into_bins.bddl")
  )
)
