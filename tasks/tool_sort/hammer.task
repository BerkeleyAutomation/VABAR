; -*- mode: lisp -*-
; -------------------------------------------------------------------------
; RECONSTRUCTED -- not the upstream file.
;
; provenance.tier: reconstructed
; source-of-record: robosimstudio/tasks/tool_sort/suite.py
; upstream:         VAB-industrial/bddl_files/tool_sort/pick_up_the_hammer_and_place_it_in_bin2.bddl
;
; The upstream .bddl files are NOT vendored here -- assets/PROVENANCE.md is
; explicit that the VAB-industrial BDDL content is transcribed into the suite
; as region literals and goal pairs, not copied as files. This reverses that
; transcription: every number below is read back out of the suite, which took
; them from the original to the digit.
;
; READ THE CIRCULARITY BEFORE TRUSTING A ROUND TRIP. A parser checked against
; this file is checked against our own transcription, not against upstream.
;
; The same scene as sort_all -- the environment always builds the whole
; pile -- with a goal concerning only hammer_0. That is what makes the
; reward difference legible: half-sorted, this reads 1.0 as soon as the
; hammer lands and sort_all reads 0.5.
; -------------------------------------------------------------------------

(define (problem PICK_UP_THE_HAMMER_AND_PLACE_IT_IN_BIN2)

  (:language pick up the hammer from the cluttered bin1 pile and place it
             in the hammer compartment of bin2)

  ; What BDDL cannot say: which cell, which robot, which export. The profile
  ; supplies the first two for every VAB-industrial problem; the export is
  ; this variant's own, and names the dumped scene its poses come from.
  (:staging
    (:profile vab_tool_sort@v2)
    ; The workcell wearing the materials its MJCF states -- see assets/look.py.
    (:export vab_tool_sort
      (:entity tool_sort_workcell))
    ; 2400 for one goal.
    ;
    ; 2400 is sized for reference-parity motion, not for the plan-mode
    ; lunge: the benchmark's own scripted pick is ~8 waypoints
    ; held 45-80 control steps each at 20 Hz, about 24 s of simulated time,
    ; which at this suite's 50 Hz is ~1200 steps before any margin. A ceiling
    ; that punished moving the way the benchmark moves would be measuring the
    ; ceiling. A container goal adds a flat 9000, measured rather than scaled:
    ; posting a tool through a hole is a much longer sequence than releasing
    ; it over an open compartment, and the goal is retried once before being
    ; given up, so the budget has to cover two passes.
    (:max-steps 2400)
  )

  ; Fixtures carry the regions; the tools are what moves.
  (:fixtures
    bin1 - bin
    bin2 - bin
  )

  (:objects
    hammer_0 - hammer
    drill_0 - drill
    round_nut_0 - round_nut
    clamp_0 - clamp
  )

  ; Regions are stated in their target's OWN frame, in metres, as
  ; (x0 y0 x1 y1). bin2's compartments are the quadrants of its floor.
  ;
  ; The height window is BDDL's own _eval_in: from the frame origin up
  ; 0.15 m. It starts at the origin rather than below it, which is what makes
  ; an object held ABOVE a bin fail the test and one resting on its floor
  ; pass -- and what lets a tool still between the fingers score, 15 cm up.
  (:regions
    (bin1_region
        (:target bin1)
        (:ranges ((-0.18 -0.23 0.18 0.23)))
    )
    (bin2_hammer_region
        (:target bin2)
        (:ranges ((-0.195 -0.245 0.0 0.0)))
    )
  )

  ; Everything starts in the cluttered pile -- verified after settling,
  ; not assumed: a tool placed in bin1 can bounce out of it while the
  ; scene comes to rest, and a task that assumed otherwise would run an
  ; episode whose starting state it has misdescribed.
  (:init
    (In hammer_0 bin1_region)
    (In drill_0 bin1_region)
    (In round_nut_0 bin1_region)
    (In clamp_0 bin1_region)
  )

  ; NOTE ON SEMANTICS, for whoever binds these predicates: BDDL's In is a box
  ; test that a CARRIED object satisfies. A reproduction-tier import must
  ; bind it to the weak box test and not to the stronger contact-and-at-rest
  ; predicate this stack also has, because comparability with the source
  ; benchmark outranks rigor. Rebinding it is a re-labelling, not a bug fix.
  (:goal
    (In hammer_0 bin2_hammer_region)
  )

  ; A solution is a thing that RUNS, so it stays code and is referenced.
  (:artifacts
    (:routine "routine:RoutineToolSort")
    (:tools   "tools:register_tool_sort_tools")
    (:graph gt "graphs/gt")
    (:graph gap_perception "graphs/gap_perception")
  )

  (:provenance
    (:tier reproduction)
    (:source "VAB-industrial ToolSortPickPlace,
              robosuite 1.4.0, MuJoCo 3.3.3, seed 0")
    (:upstream-file "pick_up_the_hammer_and_place_it_in_bin2.bddl")
  )
)
