; document in this directory says why its object set is worth staging,
; and that is the part a generator cannot write.
;
; provenance.tier: derived
; source-of-record: assets/vab_tool_sort/level2/level2_21/
;
; MEASURED ON THE SHIPPED SIDECAR, in metres (longest x middle x shortest):
;
;   multimeter               0.152 x 0.073 x 0.044   0.228 kg
;   crimping_pliers          0.214 x 0.062 x 0.020   0.150 kg
;   sanding_block_large      0.113 x 0.025 x 0.016   0.016 kg
;   compression_spring       0.037 x 0.027 x 0.025   0.040 kg
;
; THE OBJECTS ARE PILED, NOT LAID OUT, and that is the task rather than a
; property of it. bin1 is filled by dropping the objects from a tower, so they
; come to rest ON EACH OTHER: a grasp is often a two-object problem, what is on
; top changes as the bin is emptied, and an object under another cannot be taken
; until that one is. Two footprints overlap by up to 118.6 mm (industrial_multimeter_0 <-> industrial_crimping_pliers_0);
; the heap stands 141 mm above the bin1 frame.
;
; THERE IS NO PROMISE THE PALM FITS BESIDE ANY GIVEN OBJECT. The singulated
; variants keep every object's centre 80 mm from the two walls its own jaws
; close towards, because a 2F-85's coupler is 74.9 mm each side of the tool
; centre and bin1's walls stand 80 mm proud of its floor. A heap cannot, and
; none of the shipped piles does: the tightest centre-to-wall here is 28.3 mm,
; against their 25-87 mm.
; An object against a wall is reached by first taking what is on top of it. The
; step budget below is the suite's flat 2400 per goal, which every pile variant
; also carries -- check it against a run rather than trusting it on a new set.
;
; WHAT IS GUARANTEED is that every object starts INSIDE bin1_region -- what
; `(:init)` below asserts, tested on the object's centre. The tightest margin
; is 9.2 mm (industrial_sanding_block_large_0), in a region 0.36 x 0.46 m
; and 0.15 m tall. A pile that stacked an object out through that ceiling
; would be a document that was false before a policy acted.
;
; DROPPED AT SEED 21, spread 0.5, by this script's own sampler and NOT
; robosuite's, whose seeds mean something else. Rebuilding this scene means that
; seed and that script; the poses in the sidecar are the record either way.
;
; SETTLED for 3000 steps in the exported model, which is what the poses
; below are recorded from. The deepest contact is 0.41 mm, and the fastest
; object is still doing 0.0 mm/s (industrial_sanding_block_large_1) -- the heap has landed.
; -----------------------------------------------------------------------

(define (problem LEVEL2/LEVEL2_21)
  (:domain robosuite)

  (:language sort the 8 items out of bin1 into the compartment of
             bin2 whose label names each one)

  (:staging
    (:profile vab_industrial_robotiq@v1)
    (:export vab_tool_sort/level2/level2_21
      (:file scene_norobot.xml)
      ; Painted by assets/look.py: the export's wood bins and printed labels.
      (:entity tool_sort_workcell))
    ; 2400 per goal x 8 goals.
    (:max-steps 19200)
  )

  (:fixtures
    bin1 - bin
    bin2 - bin
  )

  (:objects
    industrial_multimeter_0 - multimeter
    industrial_crimping_pliers_0 - crimping_pliers
    industrial_sanding_block_large_0 - sanding_block_large
    industrial_sanding_block_large_1 - sanding_block_large
    industrial_sanding_block_large_2 - sanding_block_large
    industrial_compression_spring_0 - compression_spring
    industrial_compression_spring_1 - compression_spring
    industrial_compression_spring_2 - compression_spring
    distractor_industrial_spirit_level_0 - spirit_level
  )

  ; Regions are stated in their target's OWN frame, in metres, as (x0 y0 x1 y1).
  ; bin2's compartments are the quadrants of its floor.
  (:regions
    (bin1_region
        (:target bin1)
        (:ranges ((-0.18 -0.23 0.18 0.23)))
    )
    (bin2_multimeter_region
        (:target bin2)
        (:ranges ((-0.195 -0.245 0.0 0.0)))
    )
    (bin2_crimping_pliers_region
        (:target bin2)
        (:ranges ((0.0 -0.245 0.195 0.0)))
    )
    (bin2_sanding_block_large_region
        (:target bin2)
        (:ranges ((0.0 0.0 0.195 0.245)))
    )
    (bin2_compression_spring_region
        (:target bin2)
        (:ranges ((-0.195 0.0 0.0 0.245)))
    )
  )

  (:init
    (In industrial_multimeter_0 bin1_region)
    (In industrial_crimping_pliers_0 bin1_region)
    (In industrial_sanding_block_large_0 bin1_region)
    (In industrial_sanding_block_large_1 bin1_region)
    (In industrial_sanding_block_large_2 bin1_region)
    (In industrial_compression_spring_0 bin1_region)
    (In industrial_compression_spring_1 bin1_region)
    (In industrial_compression_spring_2 bin1_region)
    (In distractor_industrial_spirit_level_0 bin1_region)
  )

  (:goal
    (And
      (In industrial_multimeter_0 bin2_multimeter_region)
      (In industrial_crimping_pliers_0 bin2_crimping_pliers_region)
      (In industrial_sanding_block_large_0 bin2_sanding_block_large_region)
      (In industrial_sanding_block_large_1 bin2_sanding_block_large_region)
      (In industrial_sanding_block_large_2 bin2_sanding_block_large_region)
      (In industrial_compression_spring_0 bin2_compression_spring_region)
      (In industrial_compression_spring_1 bin2_compression_spring_region)
      (In industrial_compression_spring_2 bin2_compression_spring_region)
    )
  )

  (:artifacts
    (:routine "routine:RoutineSortFaces")
    (:tools   "tools:register_tool_sort_tools")
    (:graph gt "graphs/gt")
    (:graph gap_perception_loop "graphs/gap_perception_loop")
  )

  (:provenance
    (:tier derived)
    (:source "generated by tools/build_sort_scene.py from assets/vab_tool_sort/scene.xml,
              mujoco 3.11.0")
  )
)
