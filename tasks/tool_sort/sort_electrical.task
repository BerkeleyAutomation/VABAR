; -*- mode: lisp -*-
; -------------------------------------------------------------------------
; AUTHORED HERE -- not a reconstruction, and not an upstream file.
;
; provenance.tier: reproduction
; source-of-record: assets/vab_tool_sort/sort_electrical/
;
; The six documents beside this one were written *backwards* out of a Python
; suite that has since been deleted, and their headers say so because a round
; trip through them proves nothing about upstream. This one has no such past.
; The export came first -- dumped by tools/dump_vab_scene.py against
; VAB-industrial with the variant entry named there -- and this document was
; written against it. Every number below is either the export's own (the
; compartment quadrants, checked against `compartment_centers`) or a decision
; taken here (the step budget).
;
; So there is no circularity to warn about, and equally no upstream `.bddl` to
; compare against: `sort_electrical_kit_into_bins.bddl` is a file in the
; VAB-industrial checkout the export was dumped from, not one that ships here.
;
; The first variant whose tools come out of assets/objects/industrial/ rather
; than ycb/, and the first whose compartment labels are not the asset names:
; the plate reads BATTERY and the mesh is industrial/d_battery. The export
; names an instance after its asset, so the goals below are stated over
; `industrial_d_battery_0` while the compartment is `bin2_battery_region`.
;
; HALF THIS SET IS OUT OF REACH of a top-down parallel jaw, deliberately.
; `grasp_from_obb` closes across the OBB's short *horizontal* axis. The
; multimeter's is 0.087 m against the gripper's 0.080 m, missing by 7 mm, and
; the safety glasses' is 0.157 m, missing by twice that. Neither is a thinness
; failure: at 0.053 m and 0.061 m thick both are *inside* the span edge-on, so
; a policy that picks a face rather than the footprint gets a grip the scripted
; baseline never looks for. A baseline scores 4/8 here and the missing four are
; there to be taken.
;
; Seed 2 rather than 0, which is the only variant that needs saying: seeds
; 0, 3, 4 and 7 eject an item over a bin wall during the export's 3000-step
; re-settle. The four measured clean are 2, 5, 6 and 8.
; -------------------------------------------------------------------------

(define (problem SORT_ELECTRICAL_KIT_INTO_BINS)

  (:language sort the eight electrical kit items out of bin1 into the
             compartment of bin2 whose label names each one)

  ; What BDDL cannot say: which cell, which robot, which export. The profile
  ; supplies the first two for every VAB-industrial problem; the export is
  ; this variant's own, and names the dumped scene its poses come from.
  (:staging
    (:profile vab_tool_sort@v2)
    ; The workcell wearing the materials its MJCF states -- see assets/look.py.
    (:export vab_tool_sort/sort_electrical
      (:entity tool_sort_workcell))
    ; The box the export fitted, overriding the suite's `drawn_hull` -- see
    ; tool_sort.suite for what that hull is and why every other variant wears
    ; it. This variant and its two USD restatements exist to attribute a
    ; difference to the *importer* and to nothing else, which only works while
    ; everything else is identical -- including the collider. The USD stage
    ; authors a bounding box, so all three fit one, and this clause keeps the
    ; hull off the comparison triple only. Moving the three to the hull costs
    ; a re-export of the stage with hull colliders, which is a tools step over
    ; vendored geometry rather than a line here.
    (:collider bounding_box)
    ; 2400 per goal x 8 goals, the same arithmetic sort_new records: sized for
    ; reference-parity motion rather than for the plan-mode lunge, since a
    ; ceiling that punished moving the way the benchmark moves would be
    ; measuring the ceiling. No container goal here, so no flat addition.
    (:max-steps 19200)
  )

  ; Fixtures carry the regions; the tools are what moves.
  (:fixtures
    bin1 - bin
    bin2 - bin
  )

  ; Instance names are the export's own body names -- `industrial_` is the
  ; asset pool the mesh came from, flattened out of `industrial/d_battery` --
  ; and the type after the dash is what the catalog calls it. The two differ
  ; here for the first time in this suite, which is the point of the header.
  (:objects
    industrial_d_battery_0 - battery
    industrial_d_battery_1 - battery
    industrial_multimeter_0 - multimeter
    industrial_multimeter_1 - multimeter
    industrial_tactical_flashlight_0 - flashlight
    industrial_tactical_flashlight_1 - flashlight
    industrial_safety_glasses_0 - safety_glasses
    industrial_safety_glasses_1 - safety_glasses
    distractor_industrial_cutting_pliers_0 - cutting_pliers
    distractor_industrial_screwdriver_0 - screwdriver
  )

  ; Regions are stated in their target's OWN frame, in metres, as
  ; (x0 y0 x1 y1). bin2's compartments are the quadrants of its floor, and
  ; these four literals are every other variant's unchanged -- the quadrants
  ; are the bin's geometry, not the task's. Checked against the export:
  ; each range's centre is `compartment_centers[i]` to the digit.
  ;
  ; The height window is BDDL's own _eval_in: from the frame origin up
  ; 0.15 m. It starts at the origin rather than below it, which is what makes
  ; an object held ABOVE a bin fail the test and one resting on its floor
  ; pass -- and what lets a tool still between the fingers score, 15 cm up.
  (:regions
    (bin1_region
        (:target bin1)
        (:ranges ((-0.18 -0.23 0.18 0.23)))
    )
    (bin2_battery_region
        (:target bin2)
        (:ranges ((-0.195 -0.245 0.0 0.0)))
    )
    (bin2_multimeter_region
        (:target bin2)
        (:ranges ((0.0 -0.245 0.195 0.0)))
    )
    (bin2_flashlight_region
        (:target bin2)
        (:ranges ((-0.195 0.0 0.0 0.245)))
    )
    (bin2_safety_glasses_region
        (:target bin2)
        (:ranges ((0.0 0.0 0.195 0.245)))
    )
  )

  ; Everything starts in the cluttered pile -- verified after settling,
  ; not assumed: a tool placed in bin1 can bounce out of it while the
  ; scene comes to rest, and a task that assumed otherwise would run an
  ; episode whose starting state it has misdescribed. Ten objects is the
  ; density ceiling bin1's clutter sampler holds.
  (:init
    (In industrial_d_battery_0 bin1_region)
    (In industrial_d_battery_1 bin1_region)
    (In industrial_multimeter_0 bin1_region)
    (In industrial_multimeter_1 bin1_region)
    (In industrial_tactical_flashlight_0 bin1_region)
    (In industrial_tactical_flashlight_1 bin1_region)
    (In industrial_safety_glasses_0 bin1_region)
    (In industrial_safety_glasses_1 bin1_region)
    (In distractor_industrial_cutting_pliers_0 bin1_region)
    (In distractor_industrial_screwdriver_0 bin1_region)
  )

  ; NOTE ON SEMANTICS, for whoever binds these predicates: BDDL's In is a box
  ; test that a CARRIED object satisfies. A reproduction-tier import must
  ; bind it to the weak box test and not to the stronger contact-and-at-rest
  ; predicate this stack also has, because comparability with the source
  ; benchmark outranks rigor. Rebinding it is a re-labelling, not a bug fix.
  (:goal
    (And
      (In industrial_d_battery_0 bin2_battery_region)
      (In industrial_d_battery_1 bin2_battery_region)
      (In industrial_multimeter_0 bin2_multimeter_region)
      (In industrial_multimeter_1 bin2_multimeter_region)
      (In industrial_tactical_flashlight_0 bin2_flashlight_region)
      (In industrial_tactical_flashlight_1 bin2_flashlight_region)
      (In industrial_safety_glasses_0 bin2_safety_glasses_region)
      (In industrial_safety_glasses_1 bin2_safety_glasses_region)
    )
  )

  ; A solution is a thing that RUNS, so it stays code and is referenced.
  (:artifacts
    (:routine "routine:RoutineToolSort")
    (:tools   "tools:register_tool_sort_tools")
    (:graph gt "graphs/gt")
    (:graph gap_perception "graphs/gap_perception")
  )

  (:provenance
    (:tier reproduction)
    (:source "VAB-industrial ToolSortPickPlace,
              robosuite 1.4.0, MuJoCo 3.3.3, seed 2")
    (:upstream-file "sort_electrical_kit_into_bins.bddl")
  )
)
