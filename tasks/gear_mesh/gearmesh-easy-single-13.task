(define (problem GEARMESH_EASY_SINGLE_13)

  (:suite gear_mesh)

  (:language put the gear on its peg so it meshes with the pinion, then press the red
             button at the near end of the board to start it)

  ; The cell, the arm, the physics and the cameras are the suite's. What is this
  ; draw's alone: its step budget, where its gears and its board start, and that
  ; the recorded draw IS the scene -- one episode, no sampler moving it, so a
  ; score on this document is a score on this layout.
  (:staging
    (:max-steps 6000)
    (:start-poses poses/gearmesh-easy-single-13.json)
    (:episodes (:count 1) (:seed 620292741) (:sampler fixed))
  )

  (:objects
    gear_a - gear_wheel_16t
  )

  (:fixtures
    mat   - gear_mat
    board - gear_board_16
  )

  (:init
    (loose board)
    (unstarted board)
  )

  ; Assemble, then start, then turn -- pair.task says why the `after`s nest and
  ; why `worst_of` rather than a flat `and`.
  (:goal
    (once
      (after (>= (gears-seated board) 1)
        (after (started board)
          (hold-for 1.0
            (worst_of
              (And (gear0-on-peg board) (gear0-turning board) (not (gripped gear_a.body)))
            )
          )
        )
      )
    )
  )

  (:reward (progress (turning-fraction board) (:gate 1.0)))

  (:observe
    (turning-fraction board)
    (gears-seated board)
    (press-travel board)
    (pinion-speed board)
    (gear0-ratio board)
    (gear0-signed board)
    (speed gear_a)
  )

  (:provenance
    (:tier derived)
    (:source "Drawn by tools/build_gear_scenes.py at seed 620292741 from the
              gear_mesh suite's own arithmetic (assets/layout.py draw_layout):
              the board pair.task and train.task describe, cut for 16t,
              its plate centre and chain turn drawn within the suite's stated
              bands, its gears dropped on the mat where a hand can work them.
              The row of record is assets/variants.json.")
    (:note "One of the easy level's 40 single draws; tasks/gear_mesh/difficulty.py
            says what makes 1 station that level.")
  )
)
