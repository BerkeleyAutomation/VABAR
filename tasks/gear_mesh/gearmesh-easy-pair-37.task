(define (problem GEARMESH_EASY_PAIR_37)

  (:suite gear_mesh)

  (:language put both gears on their pegs so they mesh, then press the red
             button at the near end of the board to start them)

  ; The cell, the arm, the physics and the cameras are the suite's. What is this
  ; draw's alone: its step budget, where its gears and its board start, and that
  ; the recorded draw IS the scene -- one episode, no sampler moving it, so a
  ; score on this document is a score on this layout.
  (:staging
    (:max-steps 12000)
    (:start-poses poses/gearmesh-easy-pair-37.json)
    (:episodes (:count 1) (:seed 152531648) (:sampler fixed))
  )

  (:objects
    gear_a - gear_wheel_20t
    gear_b - gear_wheel_24t
  )

  (:fixtures
    mat   - gear_mat
    board - gear_board_20_24
  )

  (:init
    (loose board)
    (unstarted board)
  )

  ; Assemble, then start, then turn -- pair.task says why the `after`s nest and
  ; why `worst_of` rather than a flat `and`.
  (:goal
    (once
      (after (>= (gears-seated board) 2)
        (after (started board)
          (hold-for 1.0
            (worst_of
              (And (gear0-on-peg board) (gear0-turning board) (not (gripped gear_a.body)))
              (And (gear1-on-peg board) (gear1-turning board) (not (gripped gear_b.body)))
            )
          )
        )
      )
    )
  )

  (:reward (progress (turning-fraction board) (:gate 1.0)))

  (:observe
    (turning-fraction board)
    (gears-seated board)
    (press-travel board)
    (pinion-speed board)
    (gear0-ratio board)
    (gear1-ratio board)
    (gear0-signed board)
    (gear1-signed board)
    (speed gear_a)
    (speed gear_b)
  )

  (:provenance
    (:tier derived)
    (:source "Drawn by tools/build_gear_scenes.py at seed 152531648 from the
              gear_mesh suite's own arithmetic (assets/layout.py draw_layout):
              the board pair.task and train.task describe, cut for 20t, 24t,
              its plate centre and chain turn drawn within the suite's stated
              bands, its gears dropped on the mat where a hand can work them.
              The row of record is assets/variants.json.")
    (:note "One of the easy level's 60 pair draws; tasks/gear_mesh/difficulty.py
            says what makes 2 stations that level.")
  )
)
