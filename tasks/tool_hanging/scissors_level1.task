; -*- mode: lisp -*-
; ---------------------------------------------------------------------------
; LEVEL 1 -- one hook, one object. See scissors.task for the family's design
; (what `encloses`/`contact-force`/`speed` mean, why the goal is an `Or` over
; both handle bows) and tasks/tool_hanging/assets/records.py's LEVEL1_Y for how
; the hook comes to be centred on the board instead of split left/right.
; Does not touch scissors.task or any other existing document.
;
; The single object is scissor_pair_1: the original two-scissor task's first
; object, with its task pose moved to the table centre x=0.600 m, y=0 by the
; start-poses file this document stages.
; The shared narrowed YAM places each arm 170 mm from the centre, retaining
; the original first scissor's arm-to-object distance without a task mount.
; ---------------------------------------------------------------------------

(define (problem HANG_ONE_SCISSOR_LEVEL1)

  (:suite tool_hanging)

  (:language hang the scissors on the hook)

  (:staging
    ; Cell, arms and arrangement are tool_hanging.suite's; the level-1 rig and
    ; the budget are ours.
    (:cameras yam_station_tool_hanging@v1)
    (:physics tool_hanging_480hz@v1)
    (:episodes (:count 5) (:seed 0) (:sampler layouts:sample_level1_layout))
    (:max-steps 7000)
    ; The record's own pair, moved to the table centre; only the pose is restated.
    (:start-poses poses/level1_start.json)
  )

  (:objects
    scissors_1 - scissor_pair_1
  )

  (:fixtures
    ; One hook, on the centre station.
    scissor_hook_1 - pegboard_hook_centre
  )

  (:init)

  (:goal
    ; Each tool hung and let go, for a second: see tool_hanging.suite for the release clause.
    (hold-for 1.0
      (And
        (Or
          (encloses scissors_1.bow scissor_hook_1.shank)
          (encloses scissors_1.bow_other scissor_hook_1.shank)
        )
        (>= (contact-force scissors_1 scissor_hook_1) 0.2)
        (<= (speed scissors_1) 0.15)
        (> (hands-clear scissors_1) 0.10)
      )
    )
  )


  (:observe
    (encloses scissors_1.bow scissor_hook_1.shank)
    (encloses scissors_1.bow_other scissor_hook_1.shank)
  )

  (:artifacts
    (:routine "routine:HangScissorRoutineLevel1")
    (:tools "tools:register_tool_hanging_tools")
    (:graph gt "graphs/gt")
    (:graph gap_perception "graphs/gap_perception")
  )

  (:provenance
    (:tier original)
    (:source "A one-object, one-holder reduction of scissors.task, authored for
              GaP graph testing. Scene, goal shape and features are
              scissors.task's own -- only the count and the centring differ.")
    (:note "HangScissorRoutineLevel1 trims HangScissorRoutine's job table to
            this document's one scissors_1/scissor_hook_1 job. It uses the
            original first scissor's SCISSOR_1_GRASP_CENTER_LOCAL and
            SCISSOR_1_HANDLE_CENTER_LOCAL landmarks and inherits the original
            procedure and 190 mm lift; the object and hook are both
            at y=0 and the task uses the shared, unshifted YAM mount.
            graphs/gt's next_job cursor is
            data-driven off the goal tree (see tasks/tool_hanging/tools.py's
            Job/jobs()) and needs no edit to run on one job instead of two.")
  )
)
