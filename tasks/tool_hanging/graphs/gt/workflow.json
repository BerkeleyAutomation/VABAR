      "inputs": {},
      "outputs": {},
      "nodes": {
        "skip": {
          "type": "script",
          "script": "scripts/give_up.py",
          "inputs": {}
        },
        "skipped": {
          "type": "noop"
        }
      },
      "edges": [
        [
          "START",
          "skip"
        ],
        [
          "skip",
          "skipped"
        ],
        [
          "skipped",
          "END"
        ]
      ],
      "exit": {
        "router_field": null,
