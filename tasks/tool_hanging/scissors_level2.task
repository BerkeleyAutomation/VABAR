; -*- mode: lisp -*-
(define (problem HANG_TWO_SCISSORS_LEVEL2)
  (:suite tool_hanging)
  (:language hang both scissors on the two hooks)
  (:staging
    (:physics tool_hanging_480hz@v1)
    (:cameras yam_station_tool_hanging@v1)
    (:episodes (:count 5) (:seed 0) (:sampler layouts:sample_level2_layout))
    (:max-steps 22000)
    (:start-poses poses/scissors_level2_start.json)
  )
  (:objects
    scissors_1 - scissor_pair_1
    scissors_2 - scissor_pair_1
    distractor_wrench_1 - wrench_adjustable_260
    distractor_pliers_2 - plier_combination
    distractor_screwdriver_3 - screwdriver_slim
  )
  (:fixtures
    scissor_hook_1 - pegboard_hook_level2_left
    scissor_hook_2 - pegboard_hook_level2_right
  )
  (:init)
  (:goal
    ; Each tool hung and let go, for a second: see tool_hanging.suite for the release clause.
    (And
      (hold-for 1.0
        (And
          (Or
            (encloses scissors_1.bow scissor_hook_1.shank)
            (encloses scissors_1.bow_other scissor_hook_1.shank)
          )
          (>= (contact-force scissors_1 scissor_hook_1) 0.2)
          (<= (speed scissors_1) 0.15)
          (> (hands-clear scissors_1) 0.10)
        )
      )
      (hold-for 1.0
        (And
          (Or
            (encloses scissors_2.bow scissor_hook_2.shank)
            (encloses scissors_2.bow_other scissor_hook_2.shank)
          )
          (>= (contact-force scissors_2 scissor_hook_2) 0.2)
          (<= (speed scissors_2) 0.15)
          (> (hands-clear scissors_2) 0.10)
        )
      )
    )
  )
  (:reward (fraction))
  (:observe
    (encloses scissors_1.bow scissor_hook_1.shank)
    (encloses scissors_2.bow scissor_hook_2.shank)
  )
  (:artifacts
    (:tools "tools:register_tool_hanging_tools")
    (:graph gap_perception "graphs/gap_perception_level2")
  )
)
