{
  "version": 3,
  "meta": {
    "name": "usbc_bulkhead_gt",
    "description": "Mate the USB-C plug into the panel-mount bulkhead using ground truth, bimanually. The support arm braces the receptacle first (sim.plan_brace): its cradle has no axial stop, so an insertion run without a brace shoves the 90 g part along its own axis instead of seating into it. The working arm then runs the suite's full-pose joint-space plan (sim.plan_insert) with calibrated partial grips (sim.set_gripper) and the closed-loop correction the open-loop reference lacks -- measure the plug's true pose in the jaws after lifting (sim.get_insertion_state), then re-plan the stroke displaced by exactly that error. The verify reads the evaluator's own gate."
  },
  "nodes": {
    "brace": {
      "type": "subgraph",
      "ref": "brace_sg"
    },
    "insert": {
      "type": "subgraph",
      "ref": "insert_sg"
    },
    "verify": {
      "type": "subgraph",
      "ref": "verify_sg"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "sim.set_gripper",
          "inputs": {
            "width": "open"
          }
        }
      ]
    },
    "linger": {
      "type": "script",
      "script": "scripts/grip_step.py",
      "inputs": {
        "preset": "open",
        "settle_steps": 150
      }
    }
  },
  "edges": [
    [
      "START",
      "brace"
    ],
    [
      "linger",
      "done"
    ]
  ],
  "conditional_edges": {
    "brace": {
      "router_field": "exit",
      "mapping": {
        "braced": "insert",
        "errored": "abort"
      }
    },
    "insert": {
      "router_field": "exit",
      "mapping": {
        "released": "verify",
        "missed": "abort",
        "errored": "abort"
      }
    },
    "verify": {
      "router_field": "exit",
      "mapping": {
        "inserted": "linger",
        "short": "abort"
      }
    }
  },
