      "inputs": {
        "stages": {
          "$ref": "aim.aim_stages"
        },
        "stage": "unlook",
        "arm_id": {
          "$ref": "aim.aim_arm_id"
        }
      }
    },
    "cross": {
      "type": "script",
      "script": "scripts/move_stage.py",
      "inputs": {
        "stages": {
          "$ref": "aim.aim_stages"
        },
        "stage": "cross",
        "arm_id": {
          "$ref": "aim.aim_arm_id"
        }
      }
    },
    "grasp": {
      "type": "subgraph",
      "ref": "grasp_sg"
    },
    "relook": {
      "type": "router",
      "script": "scripts/route_perception.py",
      "inputs": {
        "perception": {
          "$ref": "in.perception"
        }
      }
    },
    "relook_oracle": {
      "type": "subgraph",
      "ref": "relook_oracle_sg"
    },
    "relook_vision": {
      "type": "subgraph",
      "ref": "relook_vision_sg"
    },
    "stroke": {
      "type": "subgraph",
      "ref": "stroke_sg"
    },
    "done": {
      "type": "end",
      "status": "success"
    },
    "abort": {
      "type": "end",
      "status": "failure",
      "recovery": [
        {
          "tool": "usbc.set_gripper",
          "inputs": {
            "width": "open"
          }
        }
      ]
    },
    "pair": {
      "type": "script",
      "script": "scripts/next_pair.py",
      "inputs": {}
    }
  },
  "edges": [
    [
      "START",
      "pair"
    ],
    [
      "unlook",
      "cross"
    ],
    [
      "cross",
      "grasp"
    ]
  ],
