{
  "version": 3,
  "meta": {
    "observation_mode": "on_demand",
    "name": "usbc_insert_mate",
    "description": "Cabled USB-C insertion with explicit skill contracts: ground, brace a free receptacle, inspect the mouth, grasp, reobserve, push with one reseat, and release. The graph does not self-verify -- the evaluator scores the physical goal after settling, and the verify slot that used to sit here routed 'inserted' on ten of thirteen episodes that scored zero, reporting depth_mm 0.00 while it did so. Vision and oracle bodies share interfaces; evaluation uses vision with privileged tools withheld.",
    "variants": [
      "usbc_insert/insert_easy",
      "usbc_insert/insert_medium",
      "usbc_insert/port",
      "usbc_insert/bulkhead"
    ]
  },
  "nodes": {
    "ground": {
      "type": "router",
      "script": "scripts/route_perception.py",
      "inputs": {
        "perception": {
          "$ref": "in.perception"
        }
      }
    },
    "ground_oracle": {
      "type": "subgraph",
      "ref": "ground_oracle_sg"
    },
    "ground_vision": {
      "type": "subgraph",
      "ref": "ground_vision_sg"
    },
    "hold": {
      "type": "subgraph",
      "ref": "hold_sg"
    },
    "aim": {
      "type": "subgraph",
      "ref": "aim_sg"
    },
    "inspect": {
