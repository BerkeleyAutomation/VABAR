          "$ref": "in.perception"
        }
      }
    },
    "inspect_oracle": {
      "type": "subgraph",
      "ref": "inspect_oracle_sg"
    },
    "inspect_vision": {
      "type": "subgraph",
      "ref": "inspect_vision_sg"
    },
    "unlook": {
      "type": "script",
