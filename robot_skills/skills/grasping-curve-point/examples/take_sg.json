{
  "skill": "grasping-curve-point",
  "inputs": {
    "plan": "str",
    "arm_id": "int",
    "grip_open_m": "float",
    "grip_close_m": "float"
  },
  "outputs": {},
  "nodes": {
    "close_on_cable": {
      "type": "script",
      "script": "scripts/run_legs.py",
      "inputs": {
        "plan": {
          "$ref": "in.plan"
        },
        "arm_id": {
          "$ref": "in.arm_id"
        },
        "legs": "enter,reach,take",
        "open_before": false,
        "close_after": true,
        "grip_open_m": {
          "$ref": "in.grip_open_m"
        },
        "grip_close_m": {
          "$ref": "in.grip_close_m"
        }
      }
    }
  },
  "edges": [
    [
      "START",
      "close_on_cable"
    ],
    [
      "close_on_cable",
      "END"
    ]
  ],
  "conditional_edges": {},
  "exit": {
    "router_field": "route",
    "success_values": [
      "done"
    ]
  },
  "on_error": "missed"
