        },
        "arm_id": {
          "$ref": "in.arm_id"
        },
        "grip_open_m": {
          "$ref": "in.grip_open_m"
        },
        "grip_close_m": {
          "$ref": "in.grip_close_m"
        }
      }
    }
  },
  "edges": [
