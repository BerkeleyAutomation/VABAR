{
  "skill": "reobserving-held-mate",
  "inputs": {
    "scene_mouth_point": "Vec3",
    "scene_bore_axis": "Vec3",
    "scene_plug_half_h": "float",
    "inspect_mouth_point": "Vec3",
    "inspect_bore_axis": "Vec3"
  },
  "outputs": {
    "relook_body": {
      "$ref": "read.relook_body"
    },
    "mate_plug_point": {
      "$ref": "read.mate_plug_point"
    },
    "mate_mouth_point": {
      "$ref": "read.mate_mouth_point"
    },
    "mate_bore_axis": {
      "$ref": "read.mate_bore_axis"
    },
    "mate_moved_mm": {
      "$ref": "read.mate_moved_mm"
    },
    "mate_plug_axis": {
      "$ref": "read.mate_plug_axis"
    },
    "mate_plug_up": {
      "$ref": "read.mate_plug_up"
    }
  },
  "nodes": {
    "read": {
      "type": "script",
      "script": "scripts/relook_oracle.py",
      "inputs": {
        "scene_mouth_point": {
          "$ref": "in.scene_mouth_point"
        },
        "scene_bore_axis": {
          "$ref": "in.scene_bore_axis"
        },
        "scene_plug_half_h": {
          "$ref": "in.scene_plug_half_h"
        },
        "inspect_mouth_point": {
          "$ref": "in.inspect_mouth_point"
        },
        "inspect_bore_axis": {
          "$ref": "in.inspect_bore_axis"
        }
      }
    },
    "found": {
      "type": "noop"
    },
    "lost": {
      "type": "noop"
    }
  },
  "edges": [
    [
      "START",
      "read"
    ],
    [
      "found",
      "END"
    ],
    [
      "lost",
      "END"
    ]
  ],
  "conditional_edges": {
    "read": {
      "router_field": "route",
      "mapping": {
        "found": "found",
        "lost": "lost"
      }
    }
  },
  "exit": {
    "router_field": null,
    "success_values": [
      "found",
      "lost"
    ]
  },
  "on_error": "errored"
}
