# tool_sort cheap fidelity: the Level-1 scripted routine (RoutineSortFaces, 4 goals each)
# on level1_1..3 and the gt graph on level1_1..3. Run in parallel.
tool_sort ts_ref routine_l1_1 :: --task tool_sort/level1_1 --solve routine
tool_sort ts_ref routine_l1_2 :: --task tool_sort/level1_2 --solve routine
tool_sort ts_ref routine_l1_3 :: --task tool_sort/level1_3 --solve routine
tool_sort ts_ss6 routine_l1_1 :: --task tool_sort/level1_1 --solve routine
tool_sort ts_ss6 routine_l1_2 :: --task tool_sort/level1_2 --solve routine
tool_sort ts_ss6 routine_l1_3 :: --task tool_sort/level1_3 --solve routine
tool_sort ts_ss4 routine_l1_1 :: --task tool_sort/level1_1 --solve routine
tool_sort ts_ss4 routine_l1_2 :: --task tool_sort/level1_2 --solve routine
tool_sort ts_ss4 routine_l1_3 :: --task tool_sort/level1_3 --solve routine
tool_sort ts_noccd routine_l1_1 :: --task tool_sort/level1_1 --solve routine
tool_sort ts_noccd routine_l1_2 :: --task tool_sort/level1_2 --solve routine
tool_sort ts_noccd routine_l1_3 :: --task tool_sort/level1_3 --solve routine
tool_sort ts_it10 routine_l1_1 :: --task tool_sort/level1_1 --solve routine
tool_sort ts_it10 routine_l1_2 :: --task tool_sort/level1_2 --solve routine
tool_sort ts_it10 routine_l1_3 :: --task tool_sort/level1_3 --solve routine
tool_sort ts_hull32 routine_l1_1 :: --task tool_sort/level1_1 --solve routine
tool_sort ts_hull32 routine_l1_2 :: --task tool_sort/level1_2 --solve routine
tool_sort ts_ref gt_l1_1 :: --task tool_sort/level1_1 --solve graph --graph gt --bus-timeout 180
tool_sort ts_ref gt_l1_2 :: --task tool_sort/level1_2 --solve graph --graph gt --bus-timeout 180
tool_sort ts_ref gt_l1_3 :: --task tool_sort/level1_3 --solve graph --graph gt --bus-timeout 180
