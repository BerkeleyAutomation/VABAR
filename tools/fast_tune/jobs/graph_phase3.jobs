# Real-fidelity phase 3: phase 2 (seven graph processes at once) starved the on-demand
# renderer ("render was not answered within 180 s") and was discarded. At most four
# processes now: tool_hanging Level 2 reference and candidate, and the syringe reference
# beside sp_ss8 (sp_graph_l1b.jobs). sweep.py --parallel 3.
tool_hanging th_ref graph_w2f :: --task tool_hanging/wrenches_level2 --episodes 1,5 --num-worlds 2 --solve graph --graph gap_perception --motion curobo --no-privileged --perception vision --renderer rtx --bus-timeout 180 --max-steps 22000
tool_hanging th_ce2_half graph_w2f :: --task tool_hanging/wrenches_level2 --episodes 1,5 --num-worlds 2 --solve graph --graph gap_perception --motion curobo --no-privileged --perception vision --renderer rtx --bus-timeout 180 --max-steps 22000
syringe_packing sp_ref graph_l1b :: --task syringe_packing/tray_pair_both_t05 --episodes 0:2 --num-worlds 2 --solve graph --graph gap_perception --motion curobo --no-privileged --perception vision --renderer rtx --bus-timeout 180
